---
import site from '../data/site.json';
---

<div id="payment-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all animate-in fade-in zoom-in-95 my-8">
    
    <!-- Modal Header -->
    <div class="bg-gradient-to-r from-brand-600 via-brand-700 to-indigo-700 px-6 py-5 text-white flex items-center justify-between">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-brand-200">HelpIt Booking & Advance Payment</span>
        <h3 class="text-lg font-black tracking-tight" id="modal-service-name">Book Service</h3>
        <p class="text-xs text-brand-100 mt-0.5" id="modal-service-price">Minimum starting charge ₹500</p>
      </div>
      <button id="close-modal-btn" type="button" class="text-brand-200 hover:text-white rounded-xl p-1.5 hover:bg-white/10 transition-colors" aria-label="Close modal">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Body / Form -->
    <form id="payment-form" class="p-6 space-y-4 max-h-[80vh] overflow-y-auto">
      <input type="hidden" id="modal-service-id" name="serviceId" value="" />
      <input type="hidden" id="modal-base-amount" value="500" />

      <!-- Delivery Method Selection -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Select Delivery Mode *
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <label class="relative flex flex-col p-3 border rounded-xl cursor-pointer hover:border-brand-500 transition-all border-brand-500 bg-brand-50/50" id="label-remote">
            <div class="flex items-center gap-2">
              <input type="radio" name="deliveryMethod" value="remote" checked class="text-brand-600 focus:ring-brand-500" id="radio-remote" />
              <span class="text-xs font-bold text-slate-900">Remote Online</span>
            </div>
            <span class="text-[11px] text-slate-500 mt-1 pl-5">Available across India & worldwide</span>
            <span class="text-[11px] font-bold text-emerald-600 pl-5 mt-0.5">Base Price (from ₹500)</span>
          </label>

          <label class="relative flex flex-col p-3 border rounded-xl cursor-pointer hover:border-brand-500 transition-all border-slate-200 bg-white" id="label-home-visit">
            <div class="flex items-center gap-2">
              <input type="radio" name="deliveryMethod" value="home-visit" class="text-brand-600 focus:ring-brand-500" id="radio-home-visit" />
              <span class="text-xs font-bold text-slate-900">Doorstep Visit</span>
            </div>
            <span class="text-[11px] text-slate-500 mt-1 pl-5">Delhi NCR only (Noida, Delhi, etc.)</span>
            <span class="text-[11px] font-bold text-brand-600 pl-5 mt-0.5">+₹1,000 Travel Fee</span>
          </label>
        </div>
      </div>

      <!-- Home Visit Pincode & Area (Conditional) -->
      <div id="home-visit-fields" class="hidden space-y-3 p-3.5 rounded-xl bg-amber-50/70 border border-amber-200">
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          <p class="text-[11px] text-amber-900 leading-snug">
            Home visits require prior address verification in Delhi NCR. Total price = Service Price + ₹1,000.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="client-pincode" class="block text-[10px] font-bold text-amber-950 uppercase">6-Digit Pincode *</label>
            <input 
              type="text" 
              id="client-pincode" 
              name="pincode" 
              placeholder="e.g. 201301" 
              pattern="[0-9]{6}"
              class="w-full px-3 py-2 rounded-lg border border-amber-300 text-xs focus:ring-2 focus:ring-brand-500 bg-white"
            />
          </div>
          <div>
            <label for="client-area" class="block text-[10px] font-bold text-amber-950 uppercase">Locality / Sector</label>
            <input 
              type="text" 
              id="client-area" 
              name="area" 
              placeholder="e.g. Sector 62, Noida" 
              class="w-full px-3 py-2 rounded-lg border border-amber-300 text-xs focus:ring-2 focus:ring-brand-500 bg-white"
            />
          </div>
        </div>
      </div>

      <!-- Customer Details -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="client-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Name *</label>
          <input 
            type="text" 
            id="client-name" 
            name="name" 
            required 
            placeholder="e.g. Rahul Sharma"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all"
          />
        </div>

        <div>
          <label for="client-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">WhatsApp Number *</label>
          <div class="relative">
            <span class="absolute left-3 top-2.5 text-slate-400 text-xs font-semibold">+91</span>
            <input 
              type="tel" 
              id="client-phone" 
              name="phone" 
              required 
              pattern="[0-9]{10}"
              placeholder="9876543210" 
              class="w-full pl-11 pr-3 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all"
            />
          </div>
        </div>
      </div>

      <div>
        <label for="client-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email Address *</label>
        <input 
          type="email" 
          id="client-email" 
          name="email" 
          required 
          placeholder="rahul@example.com"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all"
        />
      </div>

      <div>
        <label for="client-note" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Problem Description or Desired Result</label>
        <textarea 
          id="client-note" 
          name="note" 
          rows="2" 
          placeholder="Tell us what you're stuck on, error messages, or specific deadlines..."
          class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all resize-none"
        ></textarea>
      </div>

      <!-- Transparent Total Calculation -->
      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5 text-xs">
        <div class="flex justify-between text-slate-600">
          <span>Service Base Starting Price:</span>
          <span id="summary-base-price" class="font-semibold text-slate-900">₹500</span>
        </div>
        <div id="summary-surcharge-row" class="hidden flex justify-between text-slate-600">
          <span>Home Visit Travel Fee:</span>
          <span class="font-semibold text-brand-600">+₹1,000</span>
        </div>
        <div class="pt-2 border-t border-slate-200 flex justify-between items-center text-sm">
          <span class="font-bold text-slate-900">Total Payable Advance:</span>
          <span id="summary-total-price" class="text-base font-black text-brand-600">₹500</span>
        </div>
      </div>

      <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center gap-2 text-[11px] text-emerald-800">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>Instant WhatsApp confirmation after payment. Zero passwords or OTPs asked.</span>
      </div>

      <div id="payment-error-msg" class="hidden text-xs text-red-600 bg-red-50 p-2.5 rounded-lg border border-red-200"></div>

      <button 
        type="submit" 
        id="pay-submit-btn" 
        class="w-full py-3.5 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-black text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 disabled:opacity-50"
      >
        <span id="submit-btn-text">Proceed to Razorpay (UPI / Card)</span>
        <svg id="submit-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>

      <div class="text-center">
        <a 
          id="direct-whatsapp-link"
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello HelpIt, I would like to discuss a custom service requirement before booking.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-emerald-600 transition-colors"
        >
          <span>Prefer to discuss scope first? Chat on WhatsApp &rarr;</span>
        </a>
      </div>
    </form>

  </div>
</div>

<script>
  const modal = document.getElementById('payment-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const form = document.getElementById('payment-form') as HTMLFormElement;
  const errorMsg = document.getElementById('payment-error-msg');
  const submitBtn = document.getElementById('pay-submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-btn-text');
  const spinner = document.getElementById('submit-spinner');

  const radioRemote = document.getElementById('radio-remote') as HTMLInputElement;
  const radioHomeVisit = document.getElementById('radio-home-visit') as HTMLInputElement;
  const labelRemote = document.getElementById('label-remote');
  const labelHomeVisit = document.getElementById('label-home-visit');
  const homeVisitFields = document.getElementById('home-visit-fields');

  const basePriceEl = document.getElementById('summary-base-price');
  const surchargeRow = document.getElementById('summary-surcharge-row');
  const totalPriceEl = document.getElementById('summary-total-price');
  const modalBaseAmountInput = document.getElementById('modal-base-amount') as HTMLInputElement;

  function updatePricingCalculation() {
    const base = parseInt(modalBaseAmountInput.value || '500', 10);
    const isHome = radioHomeVisit.checked;

    if (basePriceEl) basePriceEl.textContent = `₹${base.toLocaleString('en-IN')}`;

    if (isHome) {
      labelHomeVisit?.classList.add('border-brand-500', 'bg-brand-50/50');
      labelHomeVisit?.classList.remove('border-slate-200', 'bg-white');
      labelRemote?.classList.remove('border-brand-500', 'bg-brand-50/50');
      labelRemote?.classList.add('border-slate-200', 'bg-white');
      homeVisitFields?.classList.remove('hidden');
      surchargeRow?.classList.remove('hidden');
      if (totalPriceEl) totalPriceEl.textContent = `₹${(base + 1000).toLocaleString('en-IN')}`;
    } else {
      labelRemote?.classList.add('border-brand-500', 'bg-brand-50/50');
      labelRemote?.classList.remove('border-slate-200', 'bg-white');
      labelHomeVisit?.classList.remove('border-brand-500', 'bg-brand-50/50');
      labelHomeVisit?.classList.add('border-slate-200', 'bg-white');
      homeVisitFields?.classList.add('hidden');
      surchargeRow?.classList.add('hidden');
      if (totalPriceEl) totalPriceEl.textContent = `₹${base.toLocaleString('en-IN')}`;
    }
  }

  radioRemote?.addEventListener('change', updatePricingCalculation);
  radioHomeVisit?.addEventListener('change', updatePricingCalculation);

  // Global open modal helper
  window.addEventListener('open-payment-modal', ((e: CustomEvent) => {
    const { serviceId, name, priceDisplay } = e.detail;
    (document.getElementById('modal-service-id') as HTMLInputElement).value = serviceId;
    (document.getElementById('modal-service-name') as HTMLElement).textContent = name;
    (document.getElementById('modal-service-price') as HTMLElement).textContent = `Starting from ${priceDisplay} (Min ₹500)`;

    // Extract numeric price from priceDisplay
    const numericMatch = priceDisplay ? priceDisplay.replace(/,/g, '').match(/\d+/) : null;
    const parsedBase = numericMatch ? Math.max(parseInt(numericMatch[0], 10), 500) : 500;
    modalBaseAmountInput.value = parsedBase.toString();

    // Default to remote
    if (radioRemote) radioRemote.checked = true;
    updatePricingCalculation();

    errorMsg?.classList.add('hidden');
    modal?.classList.remove('hidden');
  }) as EventListener);

  function closeModal() {
    modal?.classList.add('hidden');
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitText || !spinner) return;

    const deliveryMethod = radioHomeVisit.checked ? 'home-visit' : 'remote';
    const pincode = (document.getElementById('client-pincode') as HTMLInputElement)?.value;
    const area = (document.getElementById('client-area') as HTMLInputElement)?.value;

    if (deliveryMethod === 'home-visit' && (!pincode || pincode.trim().length < 6)) {
      if (errorMsg) {
        errorMsg.textContent = 'Please enter a valid 6-digit area pincode to verify home visit availability.';
        errorMsg.classList.remove('hidden');
      }
      return;
    }

    submitBtn.disabled = true;
    submitText.textContent = "Connecting to Secure Gateway...";
    spinner.classList.remove('hidden');
    errorMsg?.classList.add('hidden');

    const formData = new FormData(form);
    const payload = {
      serviceId: formData.get('serviceId'),
      name: formData.get('name'),
      phone: formData.get('phone'),
      email: formData.get('email'),
      note: formData.get('note'),
      deliveryMethod,
      pincode: pincode || '',
      area: area || ''
    };

    try {
      const res = await fetch('/api/create-payment-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (res.ok && data.short_url) {
        window.location.href = data.short_url;
      } else {
        throw new Error(data.error || 'Failed to initiate payment.');
      }
    } catch (err: any) {
      if (errorMsg) {
        errorMsg.textContent = err.message || 'An error occurred. Please try again or chat with us on WhatsApp.';
        errorMsg.classList.remove('hidden');
      }
      submitBtn.disabled = false;
      submitText.textContent = "Proceed to Razorpay (UPI / Card)";
      spinner.classList.add('hidden');
    }
  });
</script>
