---
import site from '../data/site.json';
import categories from '../data/categories.json';

const groups = [
  { name: 'Web', list: categories.filter(c => c.group === 'Web') },
  { name: 'Apps & Extensions', list: categories.filter(c => c.group === 'Apps and Extensions') },
  { name: 'Marketing & SEO', list: categories.filter(c => c.group === 'Marketing') },
  { name: 'Design & Content', list: categories.filter(c => c.group === 'Design and Content') },
  { name: 'Tech Help', list: categories.filter(c => c.group === 'Tech Help') },
];
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-brand-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <span class="text-xl font-bold text-slate-900 tracking-tight block leading-none">{site.brandName}</span>
          <span class="text-xs text-brand-600 font-medium tracking-wide">NCR & Pan-India</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
        <!-- Mega Menu Services Trigger -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">
            <span>Services</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-600 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Mega Menu Dropdown -->
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 absolute left-1/2 -translate-x-1/2 mt-2 w-[900px] bg-white rounded-2xl shadow-2xl border border-slate-100 p-6 grid grid-cols-3 gap-6">
            <div class="col-span-3 pb-3 border-b border-slate-100 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Explore 162+ Digital & Tech Services</span>
              <a href="/services" class="text-xs font-semibold text-brand-600 hover:text-brand-700 flex items-center gap-1">
                View All Categories &rarr;
              </a>
            </div>

            {groups.slice(0, 3).map(g => (
              <div class="space-y-3">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">{g.name}</h4>
                <ul class="space-y-1.5">
                  {g.list.map(cat => (
                    <li>
                      <a href={`/services/${cat.id}`} class="block p-1.5 rounded-lg text-xs font-medium text-slate-700 hover:text-brand-600 hover:bg-brand-50/60 transition-colors">
                        <div class="font-semibold text-slate-800 hover:text-brand-600">{cat.name}</div>
                        <div class="text-[11px] text-slate-400">From ₹{cat.startingPrice.toLocaleString('en-IN')}</div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {groups.slice(3).map(g => (
              <div class="space-y-3">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">{g.name}</h4>
                <ul class="space-y-1.5">
                  {g.list.map(cat => (
                    <li>
                      <a href={`/services/${cat.id}`} class="block p-1.5 rounded-lg text-xs font-medium text-slate-700 hover:text-brand-600 hover:bg-brand-50/60 transition-colors">
                        <div class="font-semibold text-slate-800 hover:text-brand-600">{cat.name}</div>
                        <div class="text-[11px] text-slate-400">From ₹{cat.startingPrice.toLocaleString('en-IN')}</div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            <div class="p-3 bg-gradient-to-br from-brand-50 to-emerald-50 rounded-xl border border-brand-100 flex flex-col justify-between">
              <div>
                <span class="inline-block px-2 py-0.5 text-[10px] font-bold bg-brand-600 text-white rounded-full uppercase">Hero Offer</span>
                <h5 class="text-sm font-bold text-slate-900 mt-2">Technical Consultation</h5>
                <p class="text-xs text-slate-600 mt-1">60-minute 1-on-1 video call + written action plan for websites, SEO, apps & IT.</p>
              </div>
              <div class="mt-3 flex items-center justify-between">
                <span class="text-sm font-black text-brand-600">₹1,500</span>
                <a href="/services/technical-consultation" class="px-3 py-1 text-xs font-bold bg-brand-600 hover:bg-brand-700 text-white rounded-lg shadow-sm">
                  Book Call
                </a>
              </div>
            </div>

          </div>
        </div>

        <a href="/pricing" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">Pricing</a>
        <a href="/monthly-plans" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">Monthly</a>
        <a href="/custom-projects" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">Custom</a>
        <a href="/locations" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">Locations</a>
        <a href="/portfolio" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">Portfolio</a>
        <a href="/free-audit" class="px-3 py-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700 rounded-lg hover:bg-emerald-50 transition-colors flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Free Audit
        </a>
        <a href="/contact" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">Contact</a>
      </nav>

      <!-- Desktop Action CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a 
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello! I'd like to ask about your digital services.")}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm shadow-sm hover:shadow-md transition-all active:scale-95"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a 
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello! I need assistance.")}`}
          class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg"
          aria-label="WhatsApp"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </a>
        <button id="mobile-menu-toggle" type="button" class="p-2 text-slate-700 hover:bg-slate-100 rounded-lg" aria-label="Toggle menu">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-3">
    <div class="grid grid-cols-2 gap-2 text-sm font-semibold">
      <a href="/services" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">All Services (162)</a>
      <a href="/pricing" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">Packages & Pricing</a>
      <a href="/monthly-plans" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">Monthly Plans</a>
      <a href="/custom-projects" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">Custom Projects</a>
      <a href="/locations" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">City Locations</a>
      <a href="/portfolio" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">Portfolio Proof</a>
      <a href="/free-audit" class="p-2.5 rounded-lg bg-emerald-50 text-emerald-800 font-bold">Free Audit</a>
      <a href="/contact" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">Contact Us</a>
    </div>

    <div class="pt-2 border-t border-slate-100">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Service Categories</span>
      <div class="max-h-48 overflow-y-auto space-y-1 pr-1">
        {categories.map(c => (
          <a href={`/services/${c.id}`} class="flex items-center justify-between py-1.5 px-2 text-xs text-slate-700 hover:bg-slate-50 rounded">
            <span>{c.name}</span>
            <span class="text-[11px] text-slate-400 font-medium">From ₹{c.startingPrice}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
  });
</script>
