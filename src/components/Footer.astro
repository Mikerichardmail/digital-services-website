---
import site from '../data/site.json';
import categories from '../data/categories.json';
import locations from '../data/locations.json';

const primaryCategories = categories.filter(c => !c.isLegacy);
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      
      <!-- Column 1: Brand & Bio -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <img 
            src="/icon.png" 
            alt={site.brandName} 
            class="w-9 h-9 rounded-xl object-contain bg-white" 
          />
          <span class="text-xl font-bold text-white tracking-tight">{site.brandName}</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
          Empowering businesses, creators, students, and professionals across India with transparent digital services, AI setup, and technical troubleshooting from ₹500. Doorstep visits available in Delhi NCR.
        </p>
        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <div><strong class="text-slate-300">Office:</strong> {site.address}</div>
          <div><strong class="text-slate-300">WhatsApp:</strong> {site.whatsappDisplay}</div>
          <div><strong class="text-slate-300">Email:</strong> {site.email}</div>
        </div>
      </div>

      <!-- Column 2: 8 Official Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Service Categories</h4>
        <ul class="space-y-2 text-xs">
          {primaryCategories.map(cat => (
            <li>
              <a href={`/services/${cat.id}`} class="hover:text-white transition-colors flex items-center justify-between">
                <span>{cat.name}</span>
                <span class="text-[10px] text-brand-400 font-semibold">₹{cat.startingPrice}+</span>
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href="/tell-us-what-youre-stuck-on" class="text-amber-400 font-bold hover:underline flex items-center gap-1">
              <span>Tell Us What You're Stuck On &rarr;</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: High-Intent Solutions -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Popular Searches</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/instagram-views" class="hover:text-white transition-colors text-pink-400 font-medium">Instagram Views (From ₹200)</a></li>
          <li><a href="/solutions/reel-to-result" class="hover:text-white transition-colors">Reel-to-Result AI Workflow</a></li>
          <li><a href="/solutions/project-deadline-rescue" class="hover:text-white transition-colors">Project Deadline Rescue</a></li>
          <li><a href="/solutions/slow-pc-windows-troubleshooting" class="hover:text-white transition-colors">Slow Laptop & Windows Fixes</a></li>
          <li><a href="/solutions/file-format-document-emergency" class="hover:text-white transition-colors">PDF to Word & OCR Extraction</a></li>
          <li><a href="/pricing" class="hover:text-white transition-colors">Transparent Pricing (From ₹500)</a></li>
          <li><a href="/services/business-consultation-digital" class="hover:text-white transition-colors">Google Business & WhatsApp</a></li>
        </ul>
      </div>

      <!-- Column 4: Locations & Policies -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Delhi NCR & Policies</h4>
        <ul class="space-y-2 text-xs">
          {locations.map(loc => (
            <li>
              <a href={`/locations/${loc.slug}`} class="hover:text-white transition-colors flex items-center justify-between">
                <span>{loc.name}</span>
                <span class="text-[10px] text-slate-500">+₹1,000 Visit</span>
              </a>
            </li>
          ))}
          <li class="pt-2"><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/refund-policy" class="hover:text-white transition-colors">Refund & Cancellation</a></li>
          <li><a href="/delivery-policy" class="hover:text-white transition-colors">Delivery Policy</a></li>
        </ul>
      </div>

    </div>

    <!-- Security & Legitimacy Statement -->
    <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60 text-xs text-slate-400 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>
          <strong class="text-white">Customer Safety & Privacy:</strong> We never request or store client passwords or OTPs. Remote access occurs under your live supervision. Verified payment receipts and WhatsApp confirmations issued for every booking.
        </span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-950 text-emerald-400 border border-emerald-800">
          Razorpay Secured UPI & Cards
        </span>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {new Date().getFullYear()} {site.brandName}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span>Minimum Base Charge: ₹500</span>
        <span>•</span>
        <span>NCR Home Visit: +₹1,000</span>
        <span>•</span>
        <span>Remote Pan-India</span>
      </div>
    </div>

  </div>
</footer>
