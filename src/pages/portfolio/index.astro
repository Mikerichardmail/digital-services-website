---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import site from '../../data/site.json';

const projects = [
  {
    title: "SmartScan Scanner & OCR",
    category: "Android Application",
    badge: "50,000+ Downloads",
    desc: "A lightweight, privacy-first mobile document scanning engine built natively in Kotlin. Features automatic paper border detection, perspective distortion correction, local on-device ML Kit OCR, and zero cloud uploads.",
    tech: ["Kotlin", "Jetpack Compose", "Google ML Kit", "CameraX", "Room Database"],
    metrics: ["4.8★ Play Store Rating", "< 15MB APK Size", "Offline Processing"]
  },
  {
    title: "SmartQR & Dynamic Merchant UPI",
    category: "Web Application & Tool",
    badge: "2,000+ Active Daily Scans",
    desc: "A fast merchant billing tool that embeds dynamic amounts, invoice reference numbers, and custom logos into Indian NPCI-compliant UPI QR codes. Enables rapid counter checkouts without hardware POS rentals.",
    tech: ["Astro", "Tailwind CSS", "Cloudflare Pages", "Canvas API", "WebAssembly"],
    metrics: ["100/100 Lighthouse Speed", "0ms Server Latency", "Works with all Indian UPI Apps"]
  },
  {
    title: "SmartPDF Compression Engine",
    category: "Chrome Extension & WebAssembly",
    badge: "Manifest V3 Compliant",
    desc: "A client-side PDF optimization utility that reduces file sizes by up to 80% directly in the user's browser using compiled WebAssembly. Keeps sensitive legal and tax records strictly private without remote server transfer.",
    tech: ["JavaScript (ES2024)", "WebAssembly", "Manifest V3", "PDF-Lib"],
    metrics: ["Zero Data Uploads", "Instant Client Compression", "Chrome Web Store Verified"]
  }
];
---

<Base
  title={`Our Portfolio & In-House Products | ${site.brandName}`}
  description="Real proof of engineering excellence. Inspect our in-house mobile apps, web applications, and browser extensions."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16 space-y-16">
    <Breadcrumbs items={[{ label: 'Portfolio' }]} />

    <div class="max-w-3xl space-y-4">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Proof of Work</span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Real Software, Built and Maintained by Us
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        We don't just build websites for clients; we engineer our own production-grade tools, native Android apps, and browser extensions. Inspect our work below.
      </p>
    </div>

    <!-- Products Grid -->
    <div class="space-y-8">
      {projects.map((proj) => (
        <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm flex flex-col lg:flex-row gap-8 items-start justify-between">
          <div class="space-y-4 max-w-2xl">
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-50 text-brand-700 border border-brand-100">
                {proj.category}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">
                {proj.badge}
              </span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">{proj.title}</h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{proj.desc}</p>

            <div class="flex flex-wrap gap-2 pt-2">
              {proj.tech.map((t) => (
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-semibold">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="lg:w-72 shrink-0 w-full p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-4">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Engineering Benchmarks</h4>
            <ul class="space-y-2 text-xs font-semibold text-slate-800">
              {proj.metrics.map((m) => (
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500">✓</span> {m}
                </li>
              ))}
            </ul>
            <a
              href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent(`Hello! I saw your work on ${proj.title} and want to build something similar.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full block text-center py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-sm transition-all"
            >
              Build Similar Solution
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</Base>
