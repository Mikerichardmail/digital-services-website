          <!-- Important Note -->
          <div class="mt-6 p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-200 flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <div>
              <strong class="font-semibold block text-amber-300 mb-0.5">Sitemap vs Indexing Distinction:</strong>
              A page appearing in your sitemap is a crawl recommendation to Googlebot. It does <em>not</em> guarantee or claim that Google has indexed the page. Use the <strong>URL Inspection tab</strong> to verify actual indexing verdict directly from Google's index.
            </div>
          </div>

          <!-- Critical Pages Verification Matrix -->
          <div class="mt-6">
            <h3 class="text-xs font-semibold text-slate-300 uppercase tracking-wider mb-3">Core Website Pages Included in Sitemap</h3>
            <div id="criticalPagesList" class="space-y-2">
              <div class="text-xs text-slate-400">Loading verification matrix...</div>
            </div>
          </div>
