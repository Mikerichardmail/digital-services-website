---
import site from '../data/site.json';
import categories from '../data/categories.json';

// Filter primary 8 categories
const primaryCategories = categories.filter(c => !c.isLegacy);
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <span class="text-xl font-black text-slate-900 tracking-tight block leading-none">{site.brandName}</span>
          <span class="text-[11px] text-brand-600 font-bold tracking-wide mt-0.5 block">Remote India & NCR Doorstep</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
        <!-- Mega Menu Services Trigger -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-bold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">
            <span>Services</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-600 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Mega Menu Dropdown -->
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 absolute left-1/2 -translate-x-1/2 mt-2 w-[850px] bg-white rounded-2xl shadow-2xl border border-slate-100 p-6 grid grid-cols-2 gap-4">
            <div class="col-span-2 pb-3 border-b border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-slate-900">8 Core Service Categories</span>
                <span class="text-xs text-slate-500 ml-2">• Transparent pricing from ₹500</span>
              </div>
              <a href="/services" class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1">
                View Service Directory &rarr;
              </a>
            </div>

            {primaryCategories.map(cat => (
              <a 
                href={`/services/${cat.id}`} 
                class="group/item p-3 rounded-xl border border-transparent hover:border-brand-200 hover:bg-brand-50/50 transition-all flex items-start gap-3"
              >
                <div class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs shrink-0 group-hover/item:bg-brand-600 group-hover/item:text-white transition-colors">
                  &bull;
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-xs text-slate-900 group-hover/item:text-brand-600">{cat.name}</span>
                    <span class="text-[10px] font-bold text-brand-600 bg-brand-50 px-1.5 py-0.5 rounded">From ₹{cat.startingPrice}</span>
                  </div>
                  <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">{cat.shortIntro}</p>
                </div>
              </a>
            ))}

            <div class="col-span-2 pt-3 border-t border-slate-100 flex items-center justify-between bg-slate-50 -mx-6 -mb-6 p-4 rounded-b-2xl">
              <div class="text-xs text-slate-600">
                <span class="font-bold text-slate-900">Unsure what service you need?</span> Tell us what you are stuck on.
              </div>
              <a 
                href="/tell-us-what-youre-stuck-on" 
                class="px-4 py-2 text-xs font-bold bg-brand-600 hover:bg-brand-700 text-white rounded-xl shadow-sm transition-all"
              >
                Custom Help Request &rarr;
              </a>
            </div>
          </div>
        </div>

        <a href="/pricing" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">Pricing</a>
        <a href="/solutions/reel-to-result" class="px-3 py-2 text-sm font-semibold text-purple-700 hover:text-purple-800 rounded-lg hover:bg-purple-50 transition-colors">Reel-to-Result</a>
        <a href="/solutions/project-deadline-rescue" class="px-3 py-2 text-sm font-semibold text-amber-700 hover:text-amber-800 rounded-lg hover:bg-amber-50 transition-colors">Deadline Rescue</a>
        <a href="/solutions/slow-pc-windows-troubleshooting" class="px-3 py-2 text-sm font-semibold text-blue-700 hover:text-blue-800 rounded-lg hover:bg-blue-50 transition-colors">Windows & PC</a>
        <a href="/locations" class="px-3 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors">NCR Visits</a>
      </nav>

      <!-- Desktop Action CTA -->
      <div class="hidden lg:flex items-center gap-2.5">
        <a 
          href="/tell-us-what-youre-stuck-on" 
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition-all"
        >
          <span>Stuck on something?</span>
        </a>

        <a 
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello HelpIt! I need digital/technical assistance.")}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm hover:shadow-md transition-all active:scale-95"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WhatsApp Engineer</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a 
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello HelpIt! I need help.")}`}
          class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg"
          aria-label="WhatsApp"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </a>
        <button id="mobile-menu-toggle" type="button" class="p-2 text-slate-700 hover:bg-slate-100 rounded-lg" aria-label="Toggle menu">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-3">
    <div class="p-3 bg-brand-50 rounded-xl border border-brand-100 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-brand-900 block">Stuck on a technical problem?</span>
        <span class="text-[11px] text-brand-700">Get a custom quote within 30 minutes</span>
      </div>
      <a href="/tell-us-what-youre-stuck-on" class="px-3 py-1.5 text-xs font-bold bg-brand-600 text-white rounded-lg">
        Ask Here
      </a>
    </div>

    <div class="grid grid-cols-2 gap-2 text-xs font-bold">
      <a href="/services" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">All 8 Categories</a>
      <a href="/pricing" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">Pricing & Packages</a>
      <a href="/solutions/reel-to-result" class="p-2.5 rounded-lg bg-purple-50 text-purple-900">Reel-to-Result AI</a>
      <a href="/solutions/project-deadline-rescue" class="p-2.5 rounded-lg bg-amber-50 text-amber-900">Deadline Rescue</a>
      <a href="/solutions/slow-pc-windows-troubleshooting" class="p-2.5 rounded-lg bg-blue-50 text-blue-900">Slow PC & Windows</a>
      <a href="/locations" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800">NCR Home Visits</a>
    </div>

    <div class="pt-2 border-t border-slate-100">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2">Primary Categories</span>
      <div class="space-y-1">
        {primaryCategories.map(c => (
          <a href={`/services/${c.id}`} class="flex items-center justify-between py-1.5 px-2 text-xs text-slate-700 hover:bg-slate-50 rounded">
            <span>{c.name}</span>
            <span class="text-[11px] text-brand-600 font-bold">From ₹{c.startingPrice}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
  });
</script>
