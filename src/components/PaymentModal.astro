<div id="payment-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all animate-in fade-in zoom-in-95">
    
    <!-- Modal Header -->
    <div class="bg-gradient-to-r from-brand-600 to-brand-700 px-6 py-5 text-white flex items-center justify-between">
      <div>
        <h3 class="text-lg font-bold" id="modal-service-name">Book Service</h3>
        <p class="text-xs text-brand-100 mt-0.5" id="modal-service-price">Starting from ₹500</p>
      </div>
      <button id="close-modal-btn" type="button" class="text-brand-200 hover:text-white rounded-lg p-1 hover:bg-white/10 transition-colors" aria-label="Close modal">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Body / Form -->
    <form id="payment-form" class="p-6 space-y-4">
      <input type="hidden" id="modal-service-id" name="serviceId" value="" />

      <div>
        <label for="client-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Full Name *</label>
        <input 
          type="text" 
          id="client-name" 
          name="name" 
          required 
          placeholder="e.g. Rahul Sharma"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all"
        />
      </div>

      <div>
        <label for="client-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">WhatsApp / Phone Number *</label>
        <div class="relative">
          <span class="absolute left-3.5 top-2.5 text-slate-400 text-sm font-semibold">+91</span>
          <input 
            type="tel" 
            id="client-phone" 
            name="phone" 
            required 
            pattern="[0-9]{10}"
            placeholder="9876543210" 
            class="w-full pl-12 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all"
          />
        </div>
      </div>

      <div>
        <label for="client-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email Address (for invoice) *</label>
        <input 
          type="email" 
          id="client-email" 
          name="email" 
          required 
          placeholder="rahul@example.com"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all"
        />
      </div>

      <div>
        <label for="client-note" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Problem or Requirement Details (Optional)</label>
        <textarea 
          id="client-note" 
          name="note" 
          rows="2" 
          placeholder="Briefly describe your website, problem, or preferred time..."
          class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all resize-none"
        ></textarea>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-2 text-xs text-slate-500">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Secure 256-bit encrypted checkout via Razorpay. UPI, Cards & NetBanking supported.</span>
      </div>

      <div id="payment-error-msg" class="hidden text-xs text-red-600 bg-red-50 p-2.5 rounded-lg border border-red-200"></div>

      <button 
        type="submit" 
        id="pay-submit-btn" 
        class="w-full py-3 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 disabled:opacity-50"
      >
        <span id="submit-btn-text">Proceed to Razorpay</span>
        <svg id="submit-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>
    </form>

  </div>
</div>

<script>
  const modal = document.getElementById('payment-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const form = document.getElementById('payment-form') as HTMLFormElement;
  const errorMsg = document.getElementById('payment-error-msg');
  const submitBtn = document.getElementById('pay-submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-btn-text');
  const spinner = document.getElementById('submit-spinner');

  // Global open modal helper
  window.addEventListener('open-payment-modal', ((e: CustomEvent) => {
    const { serviceId, name, priceDisplay } = e.detail;
    (document.getElementById('modal-service-id') as HTMLInputElement).value = serviceId;
    (document.getElementById('modal-service-name') as HTMLElement).textContent = name;
    (document.getElementById('modal-service-price') as HTMLElement).textContent = `Booking from ${priceDisplay}`;
    errorMsg?.classList.add('hidden');
    modal?.classList.remove('hidden');
  }) as EventListener);

  function closeModal() {
    modal?.classList.add('hidden');
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitText || !spinner) return;

    submitBtn.disabled = true;
    submitText.textContent = "Creating payment link...";
    spinner.classList.remove('hidden');
    errorMsg?.classList.add('hidden');

    const formData = new FormData(form);
    const payload = {
      serviceId: formData.get('serviceId'),
      name: formData.get('name'),
      phone: formData.get('phone'),
      email: formData.get('email'),
      note: formData.get('note'),
    };

    try {
      const res = await fetch('/api/create-payment-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (res.ok && data.short_url) {
        window.location.href = data.short_url;
      } else {
        throw new Error(data.error || 'Failed to initiate payment.');
      }
    } catch (err: any) {
      if (errorMsg) {
        errorMsg.textContent = err.message || 'An error occurred. Please try again or chat with us on WhatsApp.';
        errorMsg.classList.remove('hidden');
      }
      submitBtn.disabled = false;
      submitText.textContent = "Proceed to Razorpay";
      spinner.classList.add('hidden');
    }
  });
</script>
