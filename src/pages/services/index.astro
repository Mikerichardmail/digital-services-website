---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import categories from '../../data/categories.json';
import services from '../../data/services.json';
import site from '../../data/site.json';

const groups = ['Web', 'Apps and Extensions', 'Marketing', 'Design and Content', 'Tech Help'];
---

<Base 
  title={`All Services & Categories | ${site.brandName}`}
  description="Explore 162+ transparent digital services across 17 categories. Websites, Google Maps, SEO, Android apps, and remote computer tech support from ₹500."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={[{ label: 'Services' }]} />

    <div class="max-w-3xl mb-12">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Service Catalog</span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight mt-1">
        162 Digital & Tech Services Across 17 Categories
      </h1>
      <p class="text-base text-slate-600 mt-3 leading-relaxed">
        Everything you need to launch, rank, optimize, and support your business online. Flat transparent pricing starting at ₹500 with zero surprise costs.
      </p>
    </div>

    <!-- Category Groups -->
    <div class="space-y-16">
      {groups.map((groupName) => {
        const groupCategories = categories.filter(c => c.group === groupName);
        if (groupCategories.length === 0) return null;

        return (
          <div class="space-y-6">
            <div class="border-b border-slate-200 pb-3 flex items-baseline justify-between">
              <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">{groupName}</h2>
              <span class="text-xs font-semibold text-slate-400">{groupCategories.length} Categories</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {groupCategories.map((cat) => {
                const count = services.filter(s => s.category === cat.id).length;
                return (
                  <a
                    href={`/services/${cat.id}`}
                    class="group p-6 rounded-2xl bg-white border border-slate-200 hover:border-brand-500 hover:shadow-lg transition-all flex flex-col justify-between"
                  >
                    <div>
                      <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">
                          {count} Services
                        </span>
                        <span class="text-xs font-extrabold text-brand-600">
                          From ₹{cat.startingPrice.toLocaleString('en-IN')}
                        </span>
                      </div>

                      <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
                        {cat.name}
                      </h3>

                      <p class="text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                        {cat.shortIntro}
                      </p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-brand-600">
                      <span>View Services & Rates</span>
                      <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Need Consultation CTA -->
    <div class="mt-20 p-8 rounded-3xl bg-brand-50 border border-brand-200 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl font-bold text-brand-950">Not sure which service you need?</h3>
        <p class="text-xs sm:text-sm text-brand-800 mt-1 max-w-xl">
          Book a 60-minute 1-on-1 technical consultation video call. We evaluate your business, analyze your tech setup, and provide an actionable written roadmap.
        </p>
      </div>
      <a 
        href="/services/technical-consultation"
        class="shrink-0 px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-md transition-all"
      >
        Book Consultation (₹1,500)
      </a>
    </div>

  </div>
</Base>
