---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import site from '../../data/site.json';
---

<Base
  title={`Free Google Maps & Website Audit | ${site.brandName}`}
  description="Request a 100% free digital audit for your business. We check your Google Maps visibility, speed, mobile usability, and local competitor ranking."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16 space-y-16">
    <Breadcrumbs items={[{ label: 'Free Audit' }]} />

    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-bold text-emerald-800">
        <span>100% Free • No Obligation • Delivered in 24 Hours</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Free Google Maps & Website Audit
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        Wondering why nearby customers find your competitors on Google instead of you? We run a complimentary diagnostic audit of your online presence and send a straightforward action report directly to your WhatsApp.
      </p>
    </div>

    <!-- What We Audit -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 font-bold flex items-center justify-center">
          📍
        </div>
        <h3 class="font-bold text-slate-900 text-base">Google Maps & Pin Check</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          We check your primary business category, pin accuracy, photo count, review signals, and ranking in your local area.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 font-bold flex items-center justify-center">
          ⚡
        </div>
        <h3 class="font-bold text-slate-900 text-base">Mobile Speed & Core Vitals</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          We measure load speed on 4G/5G mobile networks, broken layout elements, and technical indexing errors.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 font-bold flex items-center justify-center">
          🏆
        </div>
        <h3 class="font-bold text-slate-900 text-base">Local Competitor Comparison</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          We identify the top 3 ranking competitors in your sector/city and list exactly what steps are required to outrank them.
        </p>
      </div>
    </div>

    <!-- Free Audit Request Form -->
    <div class="bg-gradient-to-br from-slate-900 to-brand-950 rounded-3xl p-8 sm:p-12 text-white shadow-xl max-w-2xl mx-auto">
      <div class="text-center space-y-2 mb-8">
        <h2 class="text-2xl font-black">Request Your Free Audit</h2>
        <p class="text-xs sm:text-sm text-slate-300">Enter your business details below. Zero sales spam guaranteed.</p>
      </div>

      <form class="space-y-4 text-slate-900">
        <div>
          <label class="block text-xs font-bold text-slate-200 uppercase mb-1">Business Name *</label>
          <input type="text" required placeholder="e.g. City Dental Care" class="w-full px-4 py-3 rounded-xl bg-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-200 uppercase mb-1">City / Sector *</label>
          <input type="text" required placeholder="e.g. Sector 62, Noida" class="w-full px-4 py-3 rounded-xl bg-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-200 uppercase mb-1">Website URL or Google Maps Link (Optional)</label>
          <input type="text" placeholder="https://..." class="w-full px-4 py-3 rounded-xl bg-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-200 uppercase mb-1">WhatsApp Number (to receive PDF audit) *</label>
          <input type="tel" required placeholder="+91 98765 43210" class="w-full px-4 py-3 rounded-xl bg-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400" />
        </div>

        <a
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello! I would like to request a Free Google Maps & Website Audit.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full block text-center py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm shadow-md transition-all"
        >
          Send Audit Request via WhatsApp
        </a>
      </form>
    </div>

  </div>
</Base>
