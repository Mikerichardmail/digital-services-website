---
interface Props {
  serviceId: string;
  serviceName: string;
  priceDisplay: string;
  text?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  serviceId,
  serviceName,
  priceDisplay,
  text,
  size = 'md'
} = Astro.props;

const buttonText = text || (priceDisplay.includes('–') || priceDisplay.includes('+') ? `Book from ${priceDisplay.split('–')[0]}` : `Pay ${priceDisplay}`);

const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs',
  md: 'px-4 py-2 text-xs font-bold',
  lg: 'px-6 py-3 text-sm font-bold'
}[size];
---

<button
  type="button"
  data-pay-trigger
  data-service-id={serviceId}
  data-service-name={serviceName}
  data-service-price={priceDisplay}
  class={`inline-flex items-center justify-center gap-1.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-sm hover:shadow active:scale-95 transition-all ${sizeClasses}`}
>
  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
  </svg>
  <span>{buttonText}</span>
</button>

<script>
  function attachPayListeners() {
    document.querySelectorAll('[data-pay-trigger]').forEach(btn => {
      // Avoid duplicate listener
      if (btn.hasAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');
      btn.addEventListener('click', () => {
        const serviceId = btn.getAttribute('data-service-id');
        const name = btn.getAttribute('data-service-name');
        const priceDisplay = btn.getAttribute('data-service-price');
        window.dispatchEvent(new CustomEvent('open-payment-modal', {
          detail: { serviceId, name, priceDisplay }
        }));
      });
    });
  }

  attachPayListeners();
  document.addEventListener('astro:page-load', attachPayListeners);
</script>
