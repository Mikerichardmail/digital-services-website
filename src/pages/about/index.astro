---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import site from '../../data/site.json';

const excludedServices = [
  "Physical hardware repair, parts replacement, or screen/motherboard fixes",
  "On-site or physical device installations (CCTV, WiFi routers, printers, Smart TVs)",
  "YouTube channel buying / selling or subscriber packages",
  "Fake or manipulated Google / Maps reviews",
  "Unauthorized social media account or profile access",
  "Password, PIN, or SMS OTP handling / storage",
  "Duplicate, fake, or spam Google Business Profiles",
  "Google Maps spoofing or geolocation manipulation",
  "Windows activation crack or software piracy",
  "Unauthorized account-security or 2FA bypass tools"
];
---

<Base
  title={`About Us & Security Ethics | ${site.brandName}`}
  description="Learn about our mission, transparent digital services, and strict security and privacy standards across NCR & India."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16 space-y-16">
    <Breadcrumbs items={[{ label: 'About' }]} />

    <div class="max-w-3xl space-y-4">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Our Mission</span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Engineered for Honesty, Speed, and Technical Excellence
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        {site.brandName} was established to solve a widespread problem in Indian digital services: misleading quotes, poor communication, unverified contractors, and unsafe password practices.
      </p>
    </div>

    <!-- Core Values Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">
          ₹
        </div>
        <h3 class="font-bold text-slate-900 text-base">Upfront Fixed Pricing</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Every service has a listed price starting from ₹500. What you see is what you pay.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
          ⚡
        </div>
        <h3 class="font-bold text-slate-900 text-base">Rapid Remote Delivery</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Tech fixes are resolved live on remote screen within hours; web builds and designs are delivered rapidly.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
          🔒
        </div>
        <h3 class="font-bold text-slate-900 text-base">Zero-Password Guarantee</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          We strictly never store or ask for your personal passwords or OTP codes. Your data remains yours.
        </p>
      </div>
    </div>

    <!-- Services We Strictly Do NOT Offer -->
    <div class="bg-red-50/60 border border-red-200 rounded-3xl p-8 sm:p-10 space-y-6">
      <div class="space-y-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800">
          Strict Security & Compliance Policy
        </span>
        <h2 class="text-2xl font-black text-red-950">Services We Strictly Do NOT Offer</h2>
        <p class="text-xs sm:text-sm text-red-900 leading-relaxed max-w-2xl">
          To maintain 100% legal compliance and protect consumer safety, our team explicitly declines requests for unethical, fraudulent, or unauthorized services:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
        {excludedServices.map((item) => (
          <div class="p-3.5 rounded-xl bg-white/80 border border-red-100 flex items-center gap-3">
            <span class="text-red-600 font-bold text-sm shrink-0">✕</span>
            <span class="text-xs font-semibold text-slate-800">{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact & Location Strip -->
    <div class="p-8 rounded-3xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl font-bold">Have questions or want to partner?</h3>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl">
          Headquartered in NCR ({site.address}), serving customers nationwide.
        </p>
      </div>
      <a 
        href="/contact" 
        class="shrink-0 px-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs transition-all"
      >
        Contact Our Engineering Team
      </a>
    </div>

  </div>
</Base>
