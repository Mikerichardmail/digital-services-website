---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PayButton from '../../components/PayButton.astro';
import QuoteButton from '../../components/QuoteButton.astro';
import site from '../../data/site.json';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Slow Laptop Optimization & Windows Error Fix",
  "description": "Fast remote and doorstep computer repair. Fix Windows update errors, slow laptop speedup, printer Wi-Fi connection, and genuine license activation from ₹500.",
  "provider": {
    "@type": "ProfessionalService",
    "name": site.brandName,
    "telephone": site.whatsapp,
    "priceRange": "₹500 - ₹2,500"
  },
  "areaServed": ["Noida", "Gurgaon", "Delhi", "Ghaziabad", "Faridabad", "India"]
};
---

<Base
  title={`Slow Laptop Fix & Windows Update Error Troubleshooting (From ₹500) | ${site.brandName}`}
  description="Laptop running slow or freezing? Windows update stuck on 0x8007 error? Get instant remote screen share repair across India or doorstep visit in NCR from ₹500."
  schema={pageSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: 'Windows & Computer Support' }]} />

    <!-- Hero Header -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 border border-blue-200 text-xs font-bold text-blue-900">
        <span>Instant Remote Support</span>
        <span>•</span>
        <span>From ₹500 Remote</span>
        <span>•</span>
        <span>+₹1,000 Doorstep in NCR</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Slow Laptop & Windows Troubleshooting
      </h1>

      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-medium">
        Is your laptop taking 10 minutes to boot, freezing on Chrome, or stuck on a broken Windows update? We diagnose and tune up your system live without wiping your personal photos or documents.
      </p>
    </div>

    <!-- Problems We Solve -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-3">
        <span class="text-red-500 font-bold text-lg">⚡</span>
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Extreme Slowness & 100% Disk Usage</h3>
          <p class="text-xs text-slate-500 mt-1">Bloatware removal, startup delay fixes, temp cache purge, and background service throttling.</p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-3">
        <span class="text-amber-500 font-bold text-lg">↻</span>
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Windows Update Failing (0x8007... Errors)</h3>
          <p class="text-xs text-slate-500 mt-1">SoftwareDistribution rebuild, DISM & SFC system repair, and clean cumulative patch install.</p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-3">
        <span class="text-blue-500 font-bold text-lg">🖨️</span>
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Printer Offline & Wi-Fi Drops</h3>
          <p class="text-xs text-slate-500 mt-1">Driver installation for HP, Canon, Epson, Brother printers and IP spooler configuration.</p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-3">
        <span class="text-emerald-500 font-bold text-lg">🔑</span>
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Genuine Windows License Activation</h3>
          <p class="text-xs text-slate-500 mt-1">Legitimate license troubleshooting, motherboard OEM key recovery. Zero piracy tools.</p>
        </div>
      </div>
    </div>

    <!-- Transparent Pricing Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-md space-y-4 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full">Remote Online</span>
            <span class="text-2xl font-black text-slate-900">₹999 <span class="text-xs font-normal text-slate-500">Flat Bundle</span></span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mt-3">Laptop Care & Performance Tune-Up</h3>
          <ul class="mt-3 space-y-2 text-xs text-slate-600">
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Deep junk files & browser cache cleanup</li>
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Startup program speedup & bloatware removal</li>
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Full malware & adware inspection</li>
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> AnyDesk screen share under your live supervision</li>
          </ul>
        </div>
        <PayButton 
          serviceId="slow-laptop-optimization" 
          serviceName="Slow Laptop Optimization & Performance Tune-Up" 
          priceDisplay="₹999"
          size="lg"
        />
      </div>

      <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-md space-y-4 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">Delhi NCR Doorstep</span>
            <span class="text-2xl font-black text-slate-900">₹1,999 <span class="text-xs font-normal text-slate-500">Total</span></span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mt-3">Doorstep Home Visit Tune-Up</h3>
          <ul class="mt-3 space-y-2 text-xs text-slate-600">
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Complete laptop tune-up + hardware inspection</li>
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Home / Office visit in Noida, Delhi, Gurgaon, Ghaziabad</li>
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Wi-Fi router & printer connection on-site</li>
            <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Includes ₹1,000 confirmed travel charge</li>
          </ul>
        </div>
        <QuoteButton 
          serviceName="Doorstep Computer Repair & Tune-Up" 
          priceDisplay="₹1,999" 
          text="Book Home Visit on WhatsApp"
          size="lg"
        />
      </div>
    </div>

  </div>
</Base>
