---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PayButton from '../../components/PayButton.astro';
import QuoteButton from '../../components/QuoteButton.astro';
import site from '../../data/site.json';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Help Me Meet My Project Deadline — Technical Assistance",
  "description": "Urgent technical debugging, code fixes, and project emergency assistance. Hands-on expert rescue to help you deliver your project before deadline.",
  "provider": {
    "@type": "ProfessionalService",
    "name": site.brandName,
    "telephone": site.whatsapp,
    "priceRange": "₹1,500 - ₹6,000"
  },
  "areaServed": "India"
};
---

<Base
  title={`Help Me Meet My Project Deadline — Urgent Technical Assistance | ${site.brandName}`}
  description="Running out of time on an urgent technical project? Get hands-on code debugging, website rescue, build error fixes, and deadline guidance from ₹1,500."
  schema={pageSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: 'Project Deadline Rescue' }]} />

    <!-- Hero Header -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 border border-amber-200 text-xs font-bold text-amber-900">
        <span>Emergency Technical Rescue</span>
        <span>•</span>
        <span>From ₹1,500</span>
        <span>•</span>
        <span>Feasibility Verified Upfront</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Help Me Meet My Project Deadline
      </h1>

      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-medium">
        Stuck on stubborn errors right before submission? Broken builds, API failures, or deployment bugs? An experienced engineer reviews your codebase immediately and helps you cross the finish line.
      </p>
    </div>

    <!-- Emergency Checklist -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
        <div class="w-8 h-8 rounded-lg bg-red-100 text-red-700 font-bold flex items-center justify-center text-sm">!</div>
        <h3 class="font-bold text-slate-900 text-base">Instant Feasibility Audit</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          We inspect your repository, error logs, and timeline within 30 minutes. If the deadline is genuinely impossible, we tell you honestly upfront.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-sm">⚡</div>
        <h3 class="font-bold text-slate-900 text-base">Hands-On Code Fixes</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          From syntax crashes and database connection issues to mobile responsive layout glitches and broken Git merges.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-sm">✓</div>
        <h3 class="font-bold text-slate-900 text-base">Deployment & Walkthrough</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          We assist with hosting, cloud setup (Cloudflare, Vercel, VPS), and provide clear documentation so you can explain your project with confidence.
        </p>
      </div>
    </div>

    <!-- Academic & Ethical Policy Alert -->
    <div class="p-5 rounded-2xl bg-blue-50 border border-blue-200 text-xs sm:text-sm text-blue-900 space-y-2">
      <div class="flex items-center gap-2 font-bold text-blue-950">
        <svg class="w-5 h-5 text-blue-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Academic & Professional Integrity Policy</span>
      </div>
      <p class="text-xs text-blue-800 leading-relaxed">
        For academic and college projects, HelpIt strictly provides <strong>mentorship, debugging, tutoring, code reviews, and formatting assistance</strong>. We do not impersonate students or perform academic dishonesty. Customers retain full ownership and understanding of their work.
      </p>
    </div>

    <!-- Action Section -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 shadow-md flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <h3 class="text-xl font-black text-slate-900">Need emergency assistance right now?</h3>
        <p class="text-xs sm:text-sm text-slate-500">Quotes start from ₹1,500 based on verified scope and remaining turnaround time.</p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <QuoteButton 
          serviceName="Help Me Meet My Project Deadline" 
          priceDisplay="From ₹1,500" 
          text="WhatsApp Code & Deadline"
          size="lg"
        />
        <PayButton 
          serviceId="help-me-meet-my-project-deadline" 
          serviceName="Help Me Meet My Project Deadline" 
          priceDisplay="From ₹1,500"
          size="lg"
        />
      </div>
    </div>

  </div>
</Base>
