        <!-- Instagram Reel URL input -->
        <div>
          <label for="reel-url-input" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">
            Instagram Reel URL *
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-pink-500">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <input 
              type="text" 
              id="reel-url-input" 
              required 
              placeholder="https://www.instagram.com/reel/C8xxxxxxxx/" 
              class="w-full pl-11 pr-4 py-3 rounded-2xl border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all shadow-sm"
            />
          </div>
          <p class="text-[11px] text-slate-500 mt-2 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Paste your public Reel URL. Make sure your Instagram profile is public.</span>
          </p>
          <p id="url-error" class="hidden text-xs text-rose-600 font-semibold mt-1.5"></p>
        </div>

        <!-- Security / Password-Free Reassurance -->
        <div class="p-4 rounded-2xl bg-emerald-50/80 border border-emerald-200/80 flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <div class="text-xs text-emerald-950">
            <strong class="font-bold block text-emerald-900">100% Safe & Password-Free</strong>
            <span>We never ask for your Instagram password, OTPs, or login details. Your account is always completely secure.</span>
          </div>
        </div>

        <!-- Form Submission Button -->
        <div>
          <button 
            type="submit" 
            id="ig-submit-btn"
            class="w-full py-3.5 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2.5 shadow-lg shadow-emerald-600/30 active:scale-95 transition-all cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Continue to WhatsApp Order &rarr;</span>
          </button>
          <p class="text-center text-[11px] text-slate-400 mt-2">
            Opens WhatsApp directly with your prefilled package details.
          </p>
        </div>
      </form>

      <!-- Post-submission / Manual Redirect State -->
      <div id="ig-success-state" class="hidden p-6 sm:p-8 text-center space-y-4">
        <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto text-2xl font-black">
          ✓
        </div>
        <h4 class="text-lg font-black text-slate-900">Redirecting to WhatsApp...</h4>
        <p class="text-xs sm:text-sm text-slate-600 max-w-sm mx-auto leading-relaxed">
          If WhatsApp didn't open automatically in a new tab, click the button below to send your prefilled order message.
        </p>
        <div>
          <a 
            id="ig-manual-whatsapp-link" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-all active:scale-95"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Open WhatsApp Now</span>
          </a>
        </div>
        <div class="pt-2">
          <button 
            type="button" 
            id="ig-done-btn" 
            class="text-xs text-slate-500 hover:text-slate-800 underline font-medium cursor-pointer"
          >
            Close Window
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Client-side Interactive Script -->
  <script is:inline define:vars={{ whatsappNumber: site.whatsapp.replace('+', '') }}>
    (function() {
      const orderButtons = document.querySelectorAll('.ig-order-now-btn');
      const modal = document.getElementById('instagram-order-modal');
      const closeBtn = document.getElementById('close-ig-modal-btn');
      const doneBtn = document.getElementById('ig-done-btn');
      const form = document.getElementById('ig-order-form');
      const successState = document.getElementById('ig-success-state');
      const urlInput = document.getElementById('reel-url-input');
      const urlError = document.getElementById('url-error');
      const manualLink = document.getElementById('ig-manual-whatsapp-link');

      const summaryName = document.getElementById('modal-summary-name');
      const summaryViews = document.getElementById('modal-summary-views');
      const summaryPrice = document.getElementById('modal-summary-price');

      const inputPkgName = document.getElementById('selected-pkg-name');
      const inputPkgViews = document.getElementById('selected-pkg-views');
      const inputPkgPrice = document.getElementById('selected-pkg-price');

      function openModal(btn) {
        const pkgName = btn.getAttribute('data-package-name') || '';
        const pkgViews = btn.getAttribute('data-package-views') || '';
        const pkgPrice = btn.getAttribute('data-package-price') || '';
        const pkgPriceDisplay = btn.getAttribute('data-package-price-display') || ('₹' + pkgPrice);

        inputPkgName.value = pkgName;
        inputPkgViews.value = pkgViews;
        inputPkgPrice.value = pkgPrice;

        if (summaryName) summaryName.textContent = pkgName;
        if (summaryViews) summaryViews.textContent = pkgViews + ' Views';
        if (summaryPrice) summaryPrice.textContent = pkgPriceDisplay;

        if (urlInput) urlInput.value = '';
        if (urlError) {
          urlError.classList.add('hidden');
          urlError.textContent = '';
        }

        if (form) form.classList.remove('hidden');
        if (successState) successState.classList.add('hidden');

        if (modal) {
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          setTimeout(() => {
            if (urlInput) urlInput.focus();
          }, 100);
        }
      }

      function closeModal() {
        if (modal) {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      orderButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          openModal(btn);
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (doneBtn) doneBtn.addEventListener('click', closeModal);

      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) closeModal();
        });
      }

      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });

      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();

          let reelUrl = urlInput ? urlInput.value.trim() : '';

          if (!reelUrl) {
            if (urlError) {
              urlError.textContent = 'Please enter your Instagram Reel URL.';
              urlError.classList.remove('hidden');
            }
            if (urlInput) urlInput.focus();
            return;
          }

          // If user pasted without protocol, prepend https://
          if (!/^https?:\/\//i.test(reelUrl)) {
            reelUrl = 'https://' + reelUrl;
          }

          // Validate that the URL points to Instagram
          if (!reelUrl.toLowerCase().includes('instagram.com')) {
            if (urlError) {
              urlError.textContent = 'Please enter a valid Instagram URL (e.g. https://www.instagram.com/reel/...).';
              urlError.classList.remove('hidden');
            }
            if (urlInput) urlInput.focus();
            return;
          }

          if (urlError) {
            urlError.classList.add('hidden');
            urlError.textContent = '';
          }

          const pkgName = inputPkgName.value;
          const pkgViews = inputPkgViews.value;
          const pkgPrice = inputPkgPrice.value;

          const prefilledMessage = 
`Hello HelpIt,

I want to order Instagram views.

Package: ${pkgName}
Views: ${pkgViews}
Price: ₹${pkgPrice}
Instagram Reel URL: ${reelUrl}

Please share the next steps for placing my order.`;

          const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(prefilledMessage)}`;

          if (manualLink) {
            manualLink.setAttribute('href', waUrl);
          }

          // Switch modal view to success/redirect state
          if (form) form.classList.add('hidden');
          if (successState) successState.classList.remove('hidden');

          // Open WhatsApp
          window.open(waUrl, '_blank');
        });
      }
    })();
  </script>
</Base>
