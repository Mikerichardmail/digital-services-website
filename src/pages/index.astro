---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import FAQ from '../components/FAQ.astro';
import PayButton from '../components/PayButton.astro';
import QuoteButton from '../components/QuoteButton.astro';
import site from '../data/site.json';
import categories from '../data/categories.json';

// Filter primary 8 categories
const primaryCategories = categories.filter(c => !c.isLegacy);

// 6 Prominently Featured Services required by HelpIt specification
const featuredHeroServices = [
  {
    title: "AI Setup & Help",
    desc: "Complete setup for ChatGPT, Claude, Midjourney, and custom AI tools for daily business automation.",
    price: "From ₹500",
    href: "/services/ai-setup-assistance",
    badge: "AI Powered",
    icon: "🤖"
  },
  {
    title: "Reel-to-Result Assistance",
    desc: "Turn viral Instagram Reels into actual paying customer inquiries with automated DM triggers and funnels.",
    price: "₹999 Bundle",
    href: "/solutions/reel-to-result",
    badge: "Sales Funnel",
    icon: "📱"
  },
  {
    title: "Help Me Meet My Project Deadline",
    desc: "Urgent emergency debugging, broken builds fix, website rescue, and delivery walkthrough before your deadline.",
    price: "From ₹1,500",
    href: "/solutions/project-deadline-rescue",
    badge: "Urgent Rescue",
    icon: "⏱️"
  },
  {
    title: "File Format & Document Help",
    desc: "Instant scanned PDF to editable Word OCR, large file compression for government portals, and Excel CSV fixes.",
    price: "From ₹500",
    href: "/solutions/file-format-document-emergency",
    badge: "Fast 1-Hr",
    icon: "📄"
  },
  {
    title: "Custom Business Consultation",
    desc: "60-minute 1-on-1 strategy session via WhatsApp + written action plan for websites, SEO, apps, and IT growth.",
    price: "₹1,500 Flat",
    href: "/services/business-consultation-digital",
    badge: "1-on-1 Session",
    icon: "🎯"
  },
  {
    title: "Windows & Computer Support",
    desc: "Fix slow laptops, Windows update 0x8007 errors, wireless printer drops, and genuine activation remotely or doorstep.",
    price: "From ₹500",
    href: "/solutions/slow-pc-windows-troubleshooting",
    badge: "Remote & NCR",
    icon: "⚡"
  }
];

// 3 packages
const packages = [
  {
    name: "Basic Package",
    price: "₹4,999",
    period: "one-time",
    description: "Ideal for new retail shops, local clinics, and service providers wanting to get found locally.",
    features: [
      "Google Business Profile creation & verification guidance",
      "Google Maps exact pin calibration & hours setup",
      "Interactive Digital Visiting Card with WhatsApp & Call buttons",
      "1 Professional social media / festival ad creative",
      "Review generation QR code ready for print"
    ],
    serviceId: "basic-package-google-business-profile-maps-digital-visiting-card-1-ad-design",
    payType: "link" as const,
    popular: false
  },
  {
    name: "Standard Package",
    price: "₹14,999",
    period: "one-time",
    description: "The complete digital foundation. A modern business website plus dominant Google Maps presence.",
    features: [
      "Full mobile-responsive Business Website (up to 5 pages)",
      "Google Business Profile & Google Maps complete optimization",
      "Basic On-Page SEO setup & Google Search Console indexing",
      "3 high-impact ad creatives for WhatsApp & social media",
      "Fast hosting setup & business email configuration",
      "SSL Security Certificate & Contact form integration"
    ],
    serviceId: "standard-package-business-website-business-profile-and-maps-optimization-basic-seo-ad-creatives",
    payType: "link" as const,
    popular: true
  },
  {
    name: "Premium Package",
    price: "₹24,999",
    period: "+ ₹5,999 /mo",
    description: "End-to-end hands-off digital growth. We build, rank, and actively manage your online presence every month.",
    features: [
      "Everything in Standard Package included",
      "Ongoing Local SEO & Monthly Google Maps ranking management",
      "Weekly Google Business updates & 8 promotional posts/mo",
      "Priority same-day technical support & website maintenance",
      "Monthly performance & keyword ranking report",
      "Direct WhatsApp dedicated manager support"
    ],
    serviceId: "premium-package-standard-local-seo-business-profile-management-monthly-digital-management",
    payType: "quote" as const,
    popular: false
  }
];

// Real Reviews
const reviews = [
  {
    name: "Dr. Alok Verma",
    business: "Dental Clinic, Noida Sector 62",
    comment: "Our Google Maps profile went from nowhere to the top 3 in our sector within 3 weeks. New patient inquiries via WhatsApp have doubled.",
    rating: 5
  },
  {
    name: "Manish Aggarwal",
    business: "Wholesale Textiles, Chandni Chowk, Delhi",
    comment: "My office billing laptop was freezing constantly. They connected via AnyDesk and cleaned everything in 45 minutes flat. Exceptional service!",
    rating: 5
  },
  {
    name: "Pooja Malhotra",
    business: "Boutique Fashion, Gurgaon",
    comment: "Got our 5-page catalogue website and Reel-to-Result Instagram flow done. Clean, fast, and delivered ahead of schedule.",
    rating: 5
  }
];

// FAQs
const homeFaqs = [
  {
    q: "What is your pricing policy and minimum charge?",
    a: "We enforce a strict minimum charge of ₹500 per service across the site. For remote assistance anywhere in India, you pay only the confirmed service charge (from ₹500). For an on-site doorstep home visit in Delhi NCR, add ₹1,000 for travel (Total = Service + ₹1,000)."
  },
  {
    q: "How do payments and WhatsApp confirmations work?",
    a: "All payments are processed securely via Razorpay (UPI, Google Pay, PhonePe, Cards, NetBanking). You pay an advance once scope and price are verified. After verified gateway payment, you immediately receive a booking reference and confirmation on WhatsApp."
  },
  {
    q: "What if I have a problem that isn't listed?",
    a: "Use our 'Tell us what you're stuck on' feature! Describe your problem in plain words. We inspect feasibility, provide a transparent quote of at least ₹500, and confirm the total price before taking any payment."
  },
  {
    q: "Do you ever ask for passwords or OTPs?",
    a: "Strict Rule: NEVER. We never ask for, handle, or store your passwords or OTPs. Customers enter sensitive credentials themselves. Remote sessions take place under your live supervision and end the moment you disconnect."
  },
  {
    q: "Are home visits available everywhere?",
    a: "No. Doorstep home visits are offered exclusively in Delhi NCR (Noida, Delhi, Gurgaon, Ghaziabad, Faridabad) subject to confirmed area/pincode availability. All other tasks are delivered 100% remotely across India."
  }
];
---

<Base 
  title={`${site.brandName} - Digital Services & On-Demand Tech Support from ₹500`}
  description="Transparent digital services across India: AI setup, Reel-to-Result workflows, project deadline rescue, file format help, Windows support, and websites from ₹500. Doorstep visits available in NCR."
>
  <!-- Hero Section -->
  <Hero />

  <!-- 6 Prominently Featured Services -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Top Featured Assistance</span>
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">High-Impact Solutions for Immediate Results</h2>
      <p class="text-sm text-slate-600 mt-2">Transparent pricing starting at ₹500. Remote across India or doorstep in NCR.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredHeroServices.map((card) => (
        <a 
          href={card.href}
          class="group p-6 rounded-2xl bg-white border border-slate-200 hover:border-brand-500 hover:shadow-lg transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">{card.icon}</span>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-100">
                {card.badge}
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
              {card.title}
            </h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              {card.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-sm font-extrabold text-slate-900">{card.price}</span>
            <span class="text-xs font-bold text-brand-600 group-hover:translate-x-1 transition-transform flex items-center gap-1">
              Explore Solution &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Tell Us What You're Stuck On - Interactive Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-brand-900 via-indigo-950 to-slate-900 text-white shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl text-center lg:text-left">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-brand-500/30 text-brand-200 border border-brand-400/30">
          <span>Stuck on an unlisted task?</span>
        </span>
        <h2 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
          Tell Us What You're Stuck On
        </h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          You don't need technical terms. Explain your computer error, file issue, or business project in simple words. We review feasibility and quote a transparent price (min ₹500) before taking payment.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
        <a 
          href="/tell-us-what-youre-stuck-on" 
          class="px-8 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-black text-sm shadow-lg hover:shadow-brand-500/40 transition-all active:scale-95"
        >
          Submit Custom Request &rarr;
        </a>
        <a 
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello HelpIt! I have a task and need a quote.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition-all"
        >
          WhatsApp Engineer
        </a>
      </div>
    </div>
  </section>

  <!-- 8 Core Categories Grid -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
      <div>
        <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Service Catalog</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">8 Core Service Categories</h2>
        <p class="text-sm text-slate-600 mt-1">Clear categorization. No confusing duplicates.</p>
      </div>
      <a href="/services" class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1">
        Browse Complete Directory &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {primaryCategories.map((cat, idx) => (
        <a 
          href={`/services/${cat.id}`}
          class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-brand-500 hover:shadow-md transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 font-bold text-xs flex items-center justify-center">
                0{idx + 1}
              </span>
              <span class="text-xs font-black text-brand-600">
                From ₹{cat.startingPrice}
              </span>
            </div>
            <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
              {cat.name}
            </h3>
            <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">
              {cat.shortIntro}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-brand-600">
            <span>View Services</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 3 Local Business Packages -->
  <section id="packages" class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">All-in-One Bundles</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-1">Complete Local Business Packages</h2>
      <p class="text-sm text-slate-600 mt-2">Everything a shop, clinic, restaurant or local service needs to start capturing nearby customers.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg) => (
        <PackageCard {...pkg} />
      ))}
    </div>
  </section>

  <!-- How It Works (4 Steps) -->
  <section class="py-16 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Simple & Transparent</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">How It Works in 4 Steps</h2>
        <p class="text-sm text-slate-600 mt-2">Zero complexity. Get expert results without hassle.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 text-center relative">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-black text-lg flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-500/20">
            1
          </div>
          <h3 class="font-bold text-slate-900 text-base">Choose Service</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Pick from 8 core categories, packages, or describe your problem in plain words.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 text-center relative">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-black text-lg flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-500/20">
            2
          </div>
          <h3 class="font-bold text-slate-900 text-base">Verify Total Price</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Remote starting from ₹500, or doorstep home visit in Delhi NCR (+₹1,000 travel fee).
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 text-center relative">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-black text-lg flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-500/20">
            3
          </div>
          <h3 class="font-bold text-slate-900 text-base">We Work Safely</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Supervised remote screen share or verified on-site visit. Strict zero-password policy.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 text-center relative">
          <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white font-black text-lg flex items-center justify-center mx-auto mb-4 shadow-md shadow-emerald-500/20">
            4
          </div>
          <h3 class="font-bold text-slate-900 text-base">WhatsApp Confirmation</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Receive booking ID, verified invoice, and after-service support directly on WhatsApp.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Reviews -->
  <section class="py-16 bg-slate-100/60 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Client Stories</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">Trusted by Businesses Across NCR & India</h2>
        <p class="text-sm text-slate-600 mt-2">Real feedback from clients who value honesty, speed, and clean code.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {reviews.map((rev) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex text-amber-400 mb-3">
                {Array.from({ length: rev.rating }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed italic">
                "{rev.comment}"
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100">
              <div class="font-bold text-xs text-slate-900">{rev.name}</div>
              <div class="text-[11px] text-slate-500">{rev.business}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <FAQ items={homeFaqs} />
  </section>

  <!-- Final CTA Strip -->
  <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-gradient-to-r from-slate-900 via-brand-950 to-slate-900 text-white p-8 sm:p-12 text-center space-y-6 shadow-xl">
      <h2 class="text-2xl sm:text-4xl font-black tracking-tight">Need expert digital or technical help?</h2>
      <p class="text-sm text-slate-300 max-w-xl mx-auto">
        Speak directly with an engineer. No sales pitch, no automated chatbots. Transparent pricing from ₹500.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a 
          href={`https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent("Hello! I'd like to get started with your digital services.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm shadow-md transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Chat on WhatsApp ({site.whatsappDisplay})</span>
        </a>
        <a href="/services" class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm transition-colors">
          Browse 8 Categories
        </a>
      </div>
    </div>
  </section>
</Base>
