# Cloudflare & Node Server Environment Variables Example
# Duplicate this file as .env or .dev.vars for local development (do not commit secrets to Git)

# 1. Google PageSpeed Insights API
PAGESPEED_API_KEY=your_google_cloud_api_key_here

# 2. Google Search Console API
# The exact property URL registered in Google Search Console
SEARCH_CONSOLE_SITE_URL=https://helpit.in/

# Search Console Authentication (Option A: Recommended Service Account)
# Obtained from Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Search Console Authentication (Option B: OAuth 2.0 Client)
# If using OAuth 2.0 instead of a Service Account:
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

# 3. Razorpay Payments (Existing)
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
