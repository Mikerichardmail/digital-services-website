    </div>
  </main>

  <!-- Client-side Dashboard Script -->
  <script is:inline>
    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;
        tabBtns.forEach(b => {
          b.classList.remove('text-brand-400', 'border-brand-500', 'bg-slate-800/60', 'font-semibold');
          b.classList.add('text-slate-400', 'border-transparent', 'font-medium');
        });
        btn.classList.remove('text-slate-400', 'border-transparent', 'font-medium');
        btn.classList.add('text-brand-400', 'border-brand-500', 'bg-slate-800/60', 'font-semibold');

        tabContents.forEach(c => {
          if (c.id === target) {
            c.classList.remove('hidden');
          } else {
            c.classList.add('hidden');
          }
        });
      });
    });

    // 1. Load Search Performance Data
    async function loadPerformanceData(days = 28) {
      const spinner = document.getElementById('refreshSpinner');
      if (spinner) spinner.classList.add('animate-spin');

      try {
        const res = await fetch(`/api/seo?action=overview&days=${days}`);
        const data = await res.json();

        if (data.error) {
          alert(`Search Console API: ${data.message}`);
          return;
        }

        // Summary metrics
        document.getElementById('metricClicks').textContent = data.summary.totalClicks.toLocaleString();
        document.getElementById('metricImpressions').textContent = data.summary.totalImpressions.toLocaleString();
        document.getElementById('metricCtr').textContent = (data.summary.averageCtr * 100).toFixed(2) + '%';
        document.getElementById('metricPosition').textContent = data.summary.averagePosition.toFixed(1);

        // Daily Trends chart
        const trendContainer = document.getElementById('trendChartContainer');
        const trendRange = document.getElementById('trendDateRange');
        if (trendRange) trendRange.textContent = `${data.period.startDate} to ${data.period.endDate}`;

        if (data.trends && data.trends.length > 0) {
          const maxImpr = Math.max(...data.trends.map(t => t.impressions), 1);
          trendContainer.innerHTML = data.trends.map(t => {
            const imprHeight = Math.max(Math.round((t.impressions / maxImpr) * 110), 4);
            const clickHeight = Math.min(t.clicks * 24, 110);
            return `
              <div class="flex-1 flex flex-col items-center justify-end h-full min-w-[20px] group relative">
                <div class="w-full flex items-end justify-center gap-0.5">
                  <div style="height: ${imprHeight}px" class="w-2 bg-purple-500/40 rounded-t-sm transition-all group-hover:bg-purple-400"></div>
                  <div style="height: ${clickHeight}px" class="w-2 bg-blue-500 rounded-t-sm transition-all group-hover:bg-blue-400"></div>
                </div>
                <div class="absolute -top-10 opacity-0 group-hover:opacity-100 transition-opacity bg-slate-900 border border-slate-700 text-[10px] text-white px-2 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-20">
                  <strong>${t.date}</strong>: ${t.clicks} clicks, ${t.impressions} impr (pos ${t.position.toFixed(1)})
                </div>
              </div>
            `;
          }).join('');
        } else {
          trendContainer.innerHTML = '<div class="text-xs text-slate-400 mx-auto">No daily search data found for this window.</div>';
        }

        // Queries Table
        const tblQueries = document.getElementById('tblQueries');
        const queriesCount = document.getElementById('queriesCount');
        if (queriesCount) queriesCount.textContent = data.topQueries.length;

        if (data.topQueries.length > 0) {
          tblQueries.innerHTML = data.topQueries.map(q => `
            <tr class="hover:bg-slate-750 transition-colors">
              <td class="py-2.5 px-3 font-medium text-white">${q.query}</td>
              <td class="py-2.5 px-3 text-right text-blue-400 font-semibold">${q.clicks}</td>
              <td class="py-2.5 px-3 text-right text-slate-300">${q.impressions}</td>
              <td class="py-2.5 px-3 text-right text-emerald-400">${(q.ctr * 100).toFixed(1)}%</td>
              <td class="py-2.5 px-3 text-right text-amber-400 font-mono">${q.position.toFixed(1)}</td>
            </tr>
          `).join('');
        } else {
          tblQueries.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-slate-400">No search queries recorded yet.</td></tr>';
        }

        // Pages Table
        const tblPages = document.getElementById('tblPages');
        const pagesCount = document.getElementById('pagesCount');
        if (pagesCount) pagesCount.textContent = data.topPages.length;

        if (data.topPages.length > 0) {
          tblPages.innerHTML = data.topPages.map(p => `
            <tr class="hover:bg-slate-750 transition-colors">
              <td class="py-2.5 px-3 font-mono text-slate-300 break-all max-w-xs truncate" title="${p.page}">${p.page.replace('https://helpit.in', '') || '/'}</td>
              <td class="py-2.5 px-3 text-right text-blue-400 font-semibold">${p.clicks}</td>
              <td class="py-2.5 px-3 text-right text-slate-300">${p.impressions}</td>
              <td class="py-2.5 px-3 text-right text-emerald-400">${(p.ctr * 100).toFixed(1)}%</td>
              <td class="py-2.5 px-3 text-right text-amber-400 font-mono">${p.position.toFixed(1)}</td>
            </tr>
          `).join('');
        } else {
          tblPages.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-slate-400">No pages recorded yet.</td></tr>';
        }

        // Devices
        const devContainer = document.getElementById('deviceBreakdown');
        if (data.devices && data.devices.length > 0) {
          devContainer.innerHTML = data.devices.map(d => `
            <div class="flex items-center justify-between text-xs p-2.5 bg-slate-900/40 rounded-lg border border-slate-700/60">
              <span class="font-semibold text-slate-300 uppercase">${d.device}</span>
              <div class="flex items-center gap-3">
                <span class="text-blue-400 font-semibold">${d.clicks} clicks</span>
                <span class="text-slate-400">${d.impressions} impr</span>
                <span class="text-amber-400 font-mono">pos ${d.position.toFixed(1)}</span>
              </div>
            </div>
          `).join('');
        } else {
          devContainer.innerHTML = '<div class="text-xs text-slate-400">No device data available.</div>';
        }

        // Countries
        const cContainer = document.getElementById('countryBreakdown');
        if (data.countries && data.countries.length > 0) {
          cContainer.innerHTML = data.countries.map(c => `
            <div class="flex items-center justify-between text-xs p-2.5 bg-slate-900/40 rounded-lg border border-slate-700/60">
              <span class="font-semibold text-slate-300">${c.country}</span>
              <div class="flex items-center gap-3">
                <span class="text-blue-400 font-semibold">${c.clicks} clicks</span>
                <span class="text-slate-400">${c.impressions} impr</span>
                <span class="text-amber-400 font-mono">pos ${c.position.toFixed(1)}</span>
              </div>
            </div>
          `).join('');
        } else {
          cContainer.innerHTML = '<div class="text-xs text-slate-400">No country data available.</div>';
        }

      } catch (err) {
        console.error('Failed to load performance data:', err);
      } finally {
        if (spinner) spinner.classList.remove('animate-spin');
      }
    }

    // 2. Load SEO Opportunities
    async function loadOpportunities() {
      try {
        const res = await fetch('/api/seo?action=opportunities');
        const data = await res.json();
        if (data.error) return;

        // Striking distance
        const tblStriking = document.getElementById('tblStriking');
        const strikingCount = document.getElementById('strikingCount');
        if (strikingCount) strikingCount.textContent = `${data.strikingDistance.length} found`;

        if (data.strikingDistance.length > 0) {
          tblStriking.innerHTML = data.strikingDistance.map(item => `
            <tr class="hover:bg-slate-750 transition-colors">
              <td class="py-2.5 px-3 font-semibold text-white">${item.query}</td>
              <td class="py-2.5 px-3 font-mono text-slate-300 text-[11px] truncate max-w-xs" title="${item.page}">${item.page.replace('https://helpit.in', '') || '/'}</td>
              <td class="py-2.5 px-3 text-right text-emerald-400 font-bold font-mono">${item.position}</td>
              <td class="py-2.5 px-3 text-right text-slate-300">${item.impressions}</td>
              <td class="py-2.5 px-3 text-slate-400 text-xs">${item.action}</td>
            </tr>
          `).join('');
        } else {
          tblStriking.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-slate-400">No striking distance keywords currently detected.</td></tr>';
        }

        // Low CTR Page 1 keywords
        const tblLowCtr = document.getElementById('tblLowCtr');
        const lowCtrCount = document.getElementById('lowCtrCount');
        if (lowCtrCount) lowCtrCount.textContent = `${data.lowCtrKeywords.length} found`;

        if (data.lowCtrKeywords.length > 0) {
          tblLowCtr.innerHTML = data.lowCtrKeywords.map(item => `
            <tr class="hover:bg-slate-750 transition-colors">
              <td class="py-2.5 px-3 font-semibold text-white">${item.query}</td>
              <td class="py-2.5 px-3 font-mono text-slate-300 text-[11px] truncate max-w-xs" title="${item.page}">${item.page.replace('https://helpit.in', '') || '/'}</td>
              <td class="py-2.5 px-3 text-right text-amber-400 font-mono">${item.position}</td>
              <td class="py-2.5 px-3 text-right text-slate-300">${item.impressions}</td>
              <td class="py-2.5 px-3 text-right text-rose-400 font-semibold">${(item.ctr * 100).toFixed(1)}%</td>
              <td class="py-2.5 px-3 text-slate-400 text-xs">${item.recommendation}</td>
            </tr>
          `).join('');
        } else {
          tblLowCtr.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-slate-400">No low CTR keywords found on Page 1.</td></tr>';
        }

        // Content decay
        const decayContainer = document.getElementById('contentDecayContainer');
        const decayCount = document.getElementById('decayCount');
        if (decayCount) decayCount.textContent = `${data.contentDecay.length} alerts`;

        if (data.contentDecay.length > 0) {
          decayContainer.innerHTML = data.contentDecay.map(item => `
            <div class="p-4 bg-slate-900/60 border border-slate-700/80 rounded-xl flex flex-col md:flex-row md:items-center justify-between gap-3 text-xs">
              <div class="space-y-1">
                <span class="font-mono text-white text-sm font-semibold">${item.page}</span>
                <p class="text-slate-400">${item.recommendation}</p>
              </div>
              <div class="flex items-center gap-3">
                <div class="p-2 bg-slate-800 rounded text-center">
                  <div class="text-[10px] text-slate-400 uppercase">Clicks</div>
                  <div class="text-rose-400 font-bold">${item.clickChange} (${item.previousClicks} &rarr; ${item.currentClicks})</div>
                </div>
                <div class="p-2 bg-slate-800 rounded text-center">
                  <div class="text-[10px] text-slate-400 uppercase">Impr</div>
                  <div class="text-rose-400 font-bold">${item.impressionChange} (${item.previousImpressions} &rarr; ${item.currentImpressions})</div>
                </div>
              </div>
            </div>
          `).join('');
        } else {
          decayContainer.innerHTML = '<div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-300 text-center font-medium">✅ Excellent! No pages are currently suffering from significant content decay.</div>';
        }

      } catch (err) {
        console.error('Failed to load opportunities:', err);
      }
    }

    // 3. URL Inspection API Handler
    const btnRunInspect = document.getElementById('btnRunInspect');
    const inspectInput = document.getElementById('inspectUrlInput');
    const inspectSpinner = document.getElementById('inspectSpinner');
    const inspectCard = document.getElementById('inspectResultCard');

    async function inspectTargetUrl(urlToInspect) {
      if (!urlToInspect) return;
      inspectSpinner.classList.remove('hidden');
      btnRunInspect.disabled = true;

      try {
        const res = await fetch(`/api/seo?action=url-inspection&url=${encodeURIComponent(urlToInspect)}`);
        const data = await res.json();

        if (data.error) {
          alert(`URL Inspection Error: ${data.message}`);
          return;
        }

        inspectCard.classList.remove('hidden');
        document.getElementById('inspUrl').textContent = data.url;

        // Verdict Badge
        const verdictBadge = document.getElementById('inspVerdictBadge');
        if (data.verdict === 'PASS') {
          verdictBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          verdictBadge.textContent = '✅ INDEXED (PASS)';
        } else {
          verdictBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/30';
          verdictBadge.textContent = `⚠️ ${data.verdict}`;
        }

        document.getElementById('inspCoverageState').textContent = data.coverageState;
        document.getElementById('inspLastCrawl').textContent = data.lastCrawlTime ? new Date(data.lastCrawlTime).toLocaleString() : 'Not yet crawled';
        document.getElementById('inspRobotsState').textContent = `${data.robotsTxtState} | ${data.pageFetchState}`;

        // Canonicals
        document.getElementById('inspUserCanonical').textContent = data.userCanonical || 'None specified';
        document.getElementById('inspGoogleCanonical').textContent = data.googleCanonical || 'None chosen yet';

        const canStatus = document.getElementById('inspCanonicalStatus');
        if (data.canonicalMatch) {
          canStatus.className = 'p-3 rounded-lg text-xs bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 font-medium';
          canStatus.textContent = '✅ Perfect Canonical Alignment: Google agrees with your user-declared canonical URL.';
        } else {
          canStatus.className = 'p-3 rounded-lg text-xs bg-amber-500/10 border border-amber-500/20 text-amber-300 font-medium';
          canStatus.textContent = '⚠️ Canonical Mismatch: Google selected a different canonical than what was declared in your HTML.';
        }

      } catch (err) {
        alert(`Inspection request failed: ${err.message}`);
      } finally {
        inspectSpinner.classList.add('hidden');
        btnRunInspect.disabled = false;
      }
    }

    if (btnRunInspect) {
      btnRunInspect.addEventListener('click', () => {
        inspectTargetUrl(inspectInput.value.trim());
      });
    }

    document.querySelectorAll('.quick-url-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url;
        inspectInput.value = url;
        inspectTargetUrl(url);
      });
    });

    // 4. PageSpeed Insights API Handler
    let activeStrategy = 'mobile';
    const btnStratMobile = document.getElementById('btnStratMobile');
    const btnStratDesktop = document.getElementById('btnStratDesktop');
    const psInput = document.getElementById('psUrlInput');
    const btnRunPageSpeed = document.getElementById('btnRunPageSpeed');
    const psSpinner = document.getElementById('psSpinner');

    function setStrategy(strat) {
      activeStrategy = strat;
      if (strat === 'mobile') {
        btnStratMobile.classList.add('bg-brand-600', 'text-white');
        btnStratMobile.classList.remove('text-slate-400');
        btnStratDesktop.classList.remove('bg-brand-600', 'text-white');
        btnStratDesktop.classList.add('text-slate-400');
      } else {
        btnStratDesktop.classList.add('bg-brand-600', 'text-white');
        btnStratDesktop.classList.remove('text-slate-400');
        btnStratMobile.classList.remove('bg-brand-600', 'text-white');
        btnStratMobile.classList.add('text-slate-400');
      }
    }

    if (btnStratMobile) btnStratMobile.addEventListener('click', () => setStrategy('mobile'));
    if (btnStratDesktop) btnStratDesktop.addEventListener('click', () => setStrategy('desktop'));

    async function runPageSpeedAudit(targetUrl) {
      if (!targetUrl) return;
      psSpinner.classList.remove('hidden');
      btnRunPageSpeed.disabled = true;

      try {
        const res = await fetch(`/api/seo?action=pagespeed&url=${encodeURIComponent(targetUrl)}&strategy=${activeStrategy}`);
        const data = await res.json();

        if (data.error) {
          alert(`PageSpeed API Error: ${data.message}`);
          return;
        }

        // Scores
        const perfEl = document.getElementById('scorePerf');
        perfEl.textContent = data.scores.performance;
        perfEl.className = data.scores.performance >= 90 ? 'mt-3 text-4xl font-extrabold text-emerald-400' : 'mt-3 text-4xl font-extrabold text-amber-400';

        document.getElementById('scoreSeo').textContent = data.scores.seo;
        document.getElementById('scoreA11y').textContent = data.scores.accessibility;
        document.getElementById('scoreBp').textContent = data.scores.bestPractices;

        // Web Vitals
        const v = data.webVitals;
        document.getElementById('metricLcp').textContent = v.lcp.display;
        document.getElementById('badgeLcp').textContent = v.lcp.status;
        document.getElementById('badgeLcp').className = `mt-1 inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold ${v.lcp.status === 'GOOD' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}`;

        document.getElementById('metricCls').textContent = v.cls.display;
        document.getElementById('badgeCls').textContent = v.cls.status;
        document.getElementById('badgeCls').className = `mt-1 inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold ${v.cls.status === 'GOOD' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}`;

        document.getElementById('metricFcp').textContent = v.fcp.display;
        document.getElementById('badgeFcp').textContent = v.fcp.status;
        document.getElementById('badgeFcp').className = `mt-1 inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold ${v.fcp.status === 'GOOD' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}`;

        document.getElementById('metricTbt').textContent = v.tbt.display;
        document.getElementById('badgeTbt').textContent = v.tbt.status;
        document.getElementById('badgeTbt').className = `mt-1 inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold ${v.tbt.status === 'GOOD' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}`;

        document.getElementById('metricSi').textContent = v.speedIndex.display;
        document.getElementById('badgeSi').textContent = v.speedIndex.status;
        document.getElementById('badgeSi').className = `mt-1 inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold ${v.speedIndex.status === 'GOOD' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}`;

        document.getElementById('metricInp').textContent = v.inp.display;
        document.getElementById('badgeInp').textContent = v.inp.status;

        // Recommendations List
        const recsList = document.getElementById('psRecsList');
        const recsCount = document.getElementById('recsCount');
        if (recsCount) recsCount.textContent = `${data.recommendations.length} opportunities`;

        if (data.recommendations.length > 0) {
          recsList.innerHTML = data.recommendations.map(r => `
            <div class="p-4 bg-slate-900/60 border border-slate-700/80 rounded-xl space-y-1.5 text-xs">
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-white text-sm">${r.title}</span>
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">${r.category}</span>
              </div>
              <p class="text-slate-400">${r.description || ''}</p>
              ${r.displayValue ? `<div class="font-mono text-amber-400 font-semibold">Estimated Impact: ${r.displayValue}</div>` : ''}
            </div>
          `).join('');
        } else {
          recsList.innerHTML = '<div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-300 text-center font-medium">🎉 Flawless! No major speed or technical bottlenecks detected for this URL.</div>';
        }

      } catch (err) {
        alert(`PageSpeed audit failed: ${err.message}`);
      } finally {
        psSpinner.classList.add('hidden');
        btnRunPageSpeed.disabled = false;
      }
    }

    if (btnRunPageSpeed) {
      btnRunPageSpeed.addEventListener('click', () => {
        runPageSpeedAudit(psInput.value.trim());
      });
    }

    document.querySelectorAll('.quick-ps-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url;
        psInput.value = url;
        runPageSpeedAudit(url);
      });
    });

    // 5. Sitemaps
    async function loadSitemaps() {
      try {
        const res = await fetch('/api/seo?action=sitemaps');
        const data = await res.json();
        if (data.error) return;

        const tbl = document.getElementById('tblSitemaps');
        if (data.sitemaps.length > 0) {
          tbl.innerHTML = data.sitemaps.map(s => `
            <tr class="hover:bg-slate-750 transition-colors">
              <td class="py-2.5 px-3 font-mono font-semibold text-white">${s.path}</td>
              <td class="py-2.5 px-3 text-slate-300">${s.lastSubmitted}</td>
              <td class="py-2.5 px-3 text-slate-300">${s.lastDownloaded}</td>
              <td class="py-2.5 px-3 text-right text-amber-400 font-semibold">${s.warnings}</td>
              <td class="py-2.5 px-3 text-right text-rose-400 font-semibold">${s.errors}</td>
              <td class="py-2.5 px-3">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold ${s.errors === 0 ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300'}">
                  ${s.errors === 0 ? 'Success' : 'Has Errors'}
                </span>
              </td>
            </tr>
          `).join('');
        } else {
          tbl.innerHTML = `
            <tr>
              <td colspan="6" class="py-4 text-center text-slate-400">
                No sitemaps currently registered in Search Console. Click "Submit Sitemap" above to register <code>https://helpit.in/sitemap-index.xml</code>.
              </td>
            </tr>
          `;
        }

        // Critical pages list
        const critList = document.getElementById('criticalPagesList');
        if (data.criticalPagesVerification) {
          critList.innerHTML = data.criticalPagesVerification.map(p => `
            <div class="flex items-center justify-between p-2.5 bg-slate-900/50 border border-slate-700/60 rounded-lg text-xs">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span class="font-mono text-slate-200">${p.url}</span>
                <span class="text-slate-400 text-[11px]">(${p.type})</span>
              </div>
              <span class="text-emerald-400 font-semibold">Included in Sitemap</span>
            </div>
          `).join('');
        }

      } catch (err) {
        console.error('Failed to load sitemaps:', err);
      }
    }

    const btnSubmitSitemap = document.getElementById('btnSubmitSitemap');
    if (btnSubmitSitemap) {
      btnSubmitSitemap.addEventListener('click', async () => {
        btnSubmitSitemap.disabled = true;
        btnSubmitSitemap.textContent = 'Submitting...';
        try {
          const res = await fetch('/api/seo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'submit-sitemap', sitemapUrl: 'https://helpit.in/sitemap-index.xml' })
          });
          const data = await res.json();
          alert(data.message || 'Sitemap submitted!');
          loadSitemaps();
        } catch (err) {
          alert(`Submission failed: ${err.message}`);
        } finally {
          btnSubmitSitemap.disabled = false;
          btnSubmitSitemap.textContent = 'Submit Sitemap to Search Console';
        }
      });
    }

    // Refresh All button
    const btnRefreshAll = document.getElementById('btnRefreshAll');
    if (btnRefreshAll) {
      btnRefreshAll.addEventListener('click', () => {
        const days = document.getElementById('selPerfDays')?.value || 28;
        loadPerformanceData(days);
        loadOpportunities();
        loadSitemaps();
      });
    }

    const selPerfDays = document.getElementById('selPerfDays');
    if (selPerfDays) {
      selPerfDays.addEventListener('change', (e) => {
        loadPerformanceData(e.target.value);
      });
    }

    // Initial Load
    document.addEventListener('DOMContentLoaded', () => {
      loadPerformanceData(28);
      loadOpportunities();
      loadSitemaps();
      // Preload homepage PageSpeed
      runPageSpeedAudit('https://helpit.in/');
    });
  </script>
</Base>
