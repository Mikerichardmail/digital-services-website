---
import Base from '../../layouts/Base.astro';

// Exclude admin dashboard from public search engine indexes
const noindex = true;
---

<Base 
  title="SEO Command Center - Google Search Console & PageSpeed Insights | HelpIt.in"
  description="Internal SEO monitoring and diagnostic dashboard for HelpIt.in powered by Google Search Console API and PageSpeed Insights API."
  noindex={noindex}
>
  <main class="min-h-screen bg-slate-900 text-slate-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-6">

      <!-- Header & Status Bar -->
      <header class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 backdrop-blur-md shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <div class="p-2.5 bg-brand-600/20 border border-brand-500/30 rounded-xl text-brand-400">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <h1 class="text-2xl font-bold text-white tracking-tight">HelpIt.in SEO Command Center</h1>
              <p class="text-sm text-slate-400">Live integration with Google Search Console API & Google PageSpeed Insights API</p>
            </div>
          </div>
        </div>

        <!-- Property & API Status Badges -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Search Console (sc-domain:helpit.in)
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-500/15 text-blue-400 border border-blue-500/30">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            PageSpeed Insights API
          </span>
          <button id="btnRefreshAll" class="px-3.5 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 border border-slate-600">
            <svg id="refreshSpinner" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Refresh Data
          </button>
        </div>
      </header>

      <!-- Navigation Tabs -->
      <nav class="flex border-b border-slate-700 space-x-1 overflow-x-auto no-scrollbar pb-1 text-sm font-medium">
        <button data-tab="tab-performance" class="tab-btn px-4 py-2.5 rounded-t-xl text-brand-400 border-b-2 border-brand-500 bg-slate-800/60 font-semibold flex items-center gap-2 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
          Search Performance
        </button>
        <button data-tab="tab-opportunities" class="tab-btn px-4 py-2.5 rounded-t-xl text-slate-400 hover:text-slate-200 border-b-2 border-transparent font-medium flex items-center gap-2 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          SEO Opportunities
        </button>
        <button data-tab="tab-inspection" class="tab-btn px-4 py-2.5 rounded-t-xl text-slate-400 hover:text-slate-200 border-b-2 border-transparent font-medium flex items-center gap-2 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          URL Inspection
        </button>
        <button data-tab="tab-pagespeed" class="tab-btn px-4 py-2.5 rounded-t-xl text-slate-400 hover:text-slate-200 border-b-2 border-transparent font-medium flex items-center gap-2 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          PageSpeed & Core Web Vitals
        </button>
        <button data-tab="tab-sitemaps" class="tab-btn px-4 py-2.5 rounded-t-xl text-slate-400 hover:text-slate-200 border-b-2 border-transparent font-medium flex items-center gap-2 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Sitemaps & Indexing
        </button>
      </nav>

      <!-- TAB 1: Search Performance -->
      <section id="tab-performance" class="tab-content space-y-6">
        <!-- Date Selector -->
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-white">Google Search Performance (Last 28 Days)</h2>
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-400">Date Range:</span>
            <select id="selPerfDays" class="bg-slate-800 border border-slate-700 text-slate-200 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-brand-500">
              <option value="7">Last 7 Days</option>
              <option value="28" selected>Last 28 Days</option>
              <option value="90">Last 3 Months</option>
            </select>
          </div>
        </div>

        <!-- KPI Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Clicks</div>
            <div id="metricClicks" class="mt-2 text-3xl font-extrabold text-blue-400">--</div>
            <div class="mt-1 text-xs text-slate-400">Actual organic search clicks</div>
          </div>
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Impressions</div>
            <div id="metricImpressions" class="mt-2 text-3xl font-extrabold text-purple-400">--</div>
            <div class="mt-1 text-xs text-slate-400">Times HelpIt.in appeared in SERP</div>
          </div>
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Average CTR</div>
            <div id="metricCtr" class="mt-2 text-3xl font-extrabold text-emerald-400">--</div>
            <div class="mt-1 text-xs text-slate-400">Click-Through Rate</div>
          </div>
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Average Position</div>
            <div id="metricPosition" class="mt-2 text-3xl font-extrabold text-amber-400">--</div>
            <div class="mt-1 text-xs text-slate-400">Weighted average search rank</div>
          </div>
        </div>

        <!-- Trends Visualizer -->
        <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-6">
          <h3 class="text-sm font-semibold text-white mb-4">Search Performance Trends (Daily Clicks & Impressions)</h3>
          <div id="trendChartContainer" class="h-44 w-full flex items-end gap-1.5 overflow-x-auto pb-4 pt-4 border-b border-slate-700/60">
            <!-- Dynamic bars loaded by JS -->
            <div class="text-xs text-slate-400 mx-auto self-center">Loading trend data from Google Search Console...</div>
          </div>
          <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
            <div class="flex items-center gap-4">
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 bg-blue-500 rounded-sm"></span> Clicks</span>
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 bg-purple-500/50 rounded-sm"></span> Impressions</span>
            </div>
            <span id="trendDateRange" class="text-slate-400 text-xs">--</span>
          </div>
        </div>

        <!-- Two Columns: Top Queries & Top Pages -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Top Queries -->
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                <span>Top Search Queries</span>
                <span id="queriesCount" class="text-xs px-2 py-0.5 bg-slate-700 text-slate-300 rounded-full">0</span>
              </h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="text-slate-400 uppercase bg-slate-900/40 border-b border-slate-700">
                  <tr>
                    <th class="py-2.5 px-3 font-semibold">Query</th>
                    <th class="py-2.5 px-3 font-semibold text-right">Clicks</th>
                    <th class="py-2.5 px-3 font-semibold text-right">Impr</th>
                    <th class="py-2.5 px-3 font-semibold text-right">CTR</th>
                    <th class="py-2.5 px-3 font-semibold text-right">Pos</th>
                  </tr>
                </thead>
                <tbody id="tblQueries" class="divide-y divide-slate-700/60 text-slate-200">
                  <tr><td colspan="5" class="py-4 text-center text-slate-400">Loading queries...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Top Pages -->
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                <span>Top Performing Pages</span>
                <span id="pagesCount" class="text-xs px-2 py-0.5 bg-slate-700 text-slate-300 rounded-full">0</span>
              </h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="text-slate-400 uppercase bg-slate-900/40 border-b border-slate-700">
                  <tr>
                    <th class="py-2.5 px-3 font-semibold">Page URL</th>
                    <th class="py-2.5 px-3 font-semibold text-right">Clicks</th>
                    <th class="py-2.5 px-3 font-semibold text-right">Impr</th>
                    <th class="py-2.5 px-3 font-semibold text-right">CTR</th>
                    <th class="py-2.5 px-3 font-semibold text-right">Pos</th>
                  </tr>
                </thead>
                <tbody id="tblPages" class="divide-y divide-slate-700/60 text-slate-200">
                  <tr><td colspan="5" class="py-4 text-center text-slate-400">Loading pages...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Devices and Countries Breakdown -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5">
            <h3 class="text-sm font-semibold text-white mb-3">Device Breakdown</h3>
            <div id="deviceBreakdown" class="space-y-3">
              <div class="text-xs text-slate-400">Loading device data...</div>
            </div>
          </div>
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5">
            <h3 class="text-sm font-semibold text-white mb-3">Top Countries</h3>
            <div id="countryBreakdown" class="space-y-3">
              <div class="text-xs text-slate-400">Loading country data...</div>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB 2: SEO Opportunities -->
      <section id="tab-opportunities" class="tab-content hidden space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold text-white">Algorithmic SEO Opportunities & Diagnostics</h2>
            <p class="text-xs text-slate-400">Derived from Search Console performance data and traffic comparisons</p>
          </div>
        </div>

        <!-- Sub-section: Striking Distance Keywords (Positions 5-30) -->
        <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-sm font-semibold text-emerald-400 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                Striking Distance Keywords (Rank 5 to 30)
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">Queries ranking on Page 2 or lower half of Page 1 with high ranking potential.</p>
            </div>
            <span id="strikingCount" class="text-xs font-semibold px-2.5 py-1 bg-emerald-500/20 text-emerald-300 rounded-lg">0 found</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="text-slate-400 uppercase bg-slate-900/40 border-b border-slate-700">
                <tr>
                  <th class="py-2.5 px-3">Keyword Query</th>
                  <th class="py-2.5 px-3">Page</th>
                  <th class="py-2.5 px-3 text-right">Position</th>
                  <th class="py-2.5 px-3 text-right">Impressions</th>
                  <th class="py-2.5 px-3">Recommended Optimization</th>
                </tr>
              </thead>
              <tbody id="tblStriking" class="divide-y divide-slate-700/60 text-slate-200">
                <tr><td colspan="5" class="py-4 text-center text-slate-400">Analyzing search data...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Sub-section: High Impressions, Low CTR (Page 1 Title/Meta Optimization) -->
        <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-sm font-semibold text-amber-400 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                High Impressions, Low CTR Opportunities
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">Users are seeing your pages in Google but not clicking. Improve title tag & meta description.</p>
            </div>
            <span id="lowCtrCount" class="text-xs font-semibold px-2.5 py-1 bg-amber-500/20 text-amber-300 rounded-lg">0 found</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="text-slate-400 uppercase bg-slate-900/40 border-b border-slate-700">
                <tr>
                  <th class="py-2.5 px-3">Query</th>
                  <th class="py-2.5 px-3">Page</th>
                  <th class="py-2.5 px-3 text-right">Position</th>
                  <th class="py-2.5 px-3 text-right">Impr</th>
                  <th class="py-2.5 px-3 text-right">CTR</th>
                  <th class="py-2.5 px-3">Title & Meta Action</th>
                </tr>
              </thead>
              <tbody id="tblLowCtr" class="divide-y divide-slate-700/60 text-slate-200">
                <tr><td colspan="6" class="py-4 text-center text-slate-400">Analyzing CTR data...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Sub-section: Content Decay & Traffic Drop Alerts -->
        <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-sm font-semibold text-rose-400 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
                Content Decay & Traffic Loss Comparison
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">Pages that lost clicks or impressions compared to the previous 28-day window.</p>
            </div>
            <span id="decayCount" class="text-xs font-semibold px-2.5 py-1 bg-rose-500/20 text-rose-300 rounded-lg">0 alerts</span>
          </div>
          <div id="contentDecayContainer" class="space-y-3">
            <div class="text-xs text-slate-400 text-center py-4">Checking traffic change between periods...</div>
          </div>
        </div>
      </section>

      <!-- TAB 3: URL Inspection -->
      <section id="tab-inspection" class="tab-content hidden space-y-6">
        <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-6">
          <h2 class="text-lg font-bold text-white mb-2">Google Search Console URL Inspection API</h2>
          <p class="text-xs text-slate-400 mb-6">Inspect real-time Google indexing verdict, crawling status, canonical agreement, and mobile index coverage directly from Google.</p>

          <!-- Input Bar -->
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              id="inspectUrlInput" 
              type="url" 
              value="https://helpit.in/" 
              placeholder="https://helpit.in/services/website-seo-services/" 
              class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-brand-500"
            />
            <button 
              id="btnRunInspect" 
              class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-medium text-sm rounded-xl transition-colors shadow-md flex items-center justify-center gap-2"
            >
              <svg id="inspectSpinner" class="w-4 h-4 hidden animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
              <span>Inspect URL</span>
            </button>
          </div>

          <!-- Quick URL Pickers -->
          <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
            <span class="text-slate-400">Quick Test:</span>
            <button class="quick-url-btn px-2.5 py-1 bg-slate-700 hover:bg-slate-600 rounded text-slate-300 transition" data-url="https://helpit.in/">Homepage</button>
            <button class="quick-url-btn px-2.5 py-1 bg-slate-700 hover:bg-slate-600 rounded text-slate-300 transition" data-url="https://helpit.in/services/website-seo-services/">SEO Services</button>
            <button class="quick-url-btn px-2.5 py-1 bg-slate-700 hover:bg-slate-600 rounded text-slate-300 transition" data-url="https://helpit.in/services/windows-computer-support/">PC Support</button>
            <button class="quick-url-btn px-2.5 py-1 bg-slate-700 hover:bg-slate-600 rounded text-slate-300 transition" data-url="https://helpit.in/solutions/project-deadline-rescue/">Solutions Page</button>
            <button class="quick-url-btn px-2.5 py-1 bg-slate-700 hover:bg-slate-600 rounded text-slate-300 transition" data-url="https://helpit.in/locations/noida/">Location (Noida)</button>
          </div>
        </div>

        <!-- Inspection Result Card -->
        <div id="inspectResultCard" class="hidden bg-slate-800/80 border border-slate-700 rounded-xl p-6 space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-700/60 gap-3">
            <div>
              <div class="text-xs text-slate-400">Inspected URL</div>
              <div id="inspUrl" class="text-sm font-mono text-white font-semibold break-all">--</div>
            </div>
            <div id="inspVerdictBadge" class="self-start sm:self-auto px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">
              --
            </div>
          </div>

          <!-- Status Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-slate-900/50 border border-slate-700/60 rounded-lg p-4">
              <div class="text-xs font-medium text-slate-400">Coverage State</div>
              <div id="inspCoverageState" class="mt-1 text-sm font-semibold text-slate-200">--</div>
              <p class="text-xs text-slate-400 mt-1">Google indexing eligibility</p>
            </div>
            <div class="bg-slate-900/50 border border-slate-700/60 rounded-lg p-4">
              <div class="text-xs font-medium text-slate-400">Last Crawl Time</div>
              <div id="inspLastCrawl" class="mt-1 text-sm font-semibold text-slate-200">--</div>
              <p class="text-xs text-slate-400 mt-1">Googlebot timestamp</p>
            </div>
            <div class="bg-slate-900/50 border border-slate-700/60 rounded-lg p-4">
              <div class="text-xs font-medium text-slate-400">Robots.txt & Fetch</div>
              <div id="inspRobotsState" class="mt-1 text-sm font-semibold text-slate-200">--</div>
              <p class="text-xs text-slate-400 mt-1">Crawl accessibility</p>
            </div>
          </div>

          <!-- Canonical Comparison -->
          <div class="bg-slate-900/70 border border-slate-700 rounded-xl p-5 space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300">Canonical Tag Analysis</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
              <div class="p-3 bg-slate-800 rounded border border-slate-700/80">
                <span class="text-slate-400 block mb-1 font-sans">User-Declared Canonical:</span>
                <span id="inspUserCanonical" class="text-slate-200 break-all">--</span>
              </div>
              <div class="p-3 bg-slate-800 rounded border border-slate-700/80">
                <span class="text-slate-400 block mb-1 font-sans">Google Selected Canonical:</span>
                <span id="inspGoogleCanonical" class="text-slate-200 break-all">--</span>
              </div>
            </div>
            <div id="inspCanonicalStatus" class="p-3 rounded-lg text-xs">
              <!-- JS outputs whether canonicals match -->
            </div>
          </div>
        </div>
      </section>

      <!-- TAB 4: PageSpeed & Web Vitals -->
      <section id="tab-pagespeed" class="tab-content hidden space-y-6">
        <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-5">
            <div>
              <h2 class="text-lg font-bold text-white">Google PageSpeed Insights Audit</h2>
              <p class="text-xs text-slate-400">Live Lighthouse performance, accessibility, SEO audits, and Core Web Vitals</p>
            </div>

            <!-- Strategy Switcher (Mobile vs Desktop) -->
