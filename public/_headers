/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache Astro compiled assets with content hashes indefinitely
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static images and icons for 1 year
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Cache search index for 1 day with stale-while-revalidate for instant edge delivery
/search-index.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML documents: immediate revalidation with fresh content
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
