---
import site from '../data/site.json';
import categories from '../data/categories.json';
import locations from '../data/locations.json';
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      
      <!-- Column 1: Brand & Bio -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-xl bg-brand-500 flex items-center justify-center text-white font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-white tracking-tight">{site.brandName}</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Empowering small businesses, local shops, clinics, creators, and entrepreneurs with transparent, high-speed digital services and on-demand tech support from ₹500.
        </p>
        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <div><strong class="text-slate-300">Office:</strong> {site.address}</div>
          <div><strong class="text-slate-300">WhatsApp:</strong> {site.whatsappDisplay}</div>
          <div><strong class="text-slate-300">Email:</strong> {site.email}</div>
        </div>
      </div>

      <!-- Column 2: Popular Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Top Services</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/services/local-business-packages" class="hover:text-white transition-colors">Local Business Packages</a></li>
          <li><a href="/services/website-development" class="hover:text-white transition-colors">Website Development</a></li>
          <li><a href="/services/google-business-maps" class="hover:text-white transition-colors">Google Maps & Business Profile</a></li>
          <li><a href="/services/remote-computer-tech-help" class="hover:text-white transition-colors">Remote Computer & Tech Help</a></li>
          <li><a href="/services/android-app-development" class="hover:text-white transition-colors">Android App Development</a></li>
          <li><a href="/services/technical-consultation" class="hover:text-white transition-colors">Technical Consultation (₹1,500)</a></li>
          <li><a href="/services" class="text-brand-400 font-semibold hover:underline">View All 17 Categories &rarr;</a></li>
        </ul>
      </div>

      <!-- Column 3: Locations (NCR & India) -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">NCR Locations</h4>
        <ul class="space-y-2 text-xs">
          {locations.map(loc => (
            <li>
              <a href={`/locations/${loc.slug}`} class="hover:text-white transition-colors flex items-center justify-between">
                <span>{loc.name}</span>
                <span class="text-[10px] text-slate-500">Local Hub</span>
              </a>
            </li>
          ))}
          <li class="pt-1 text-slate-500 text-[11px] italic">Serving remote clients across all states of India.</li>
        </ul>
      </div>

      <!-- Column 4: Quick Links & Policies -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Policies & Trust</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/refund-policy" class="hover:text-white transition-colors">Refund & Cancellation Policy</a></li>
          <li><a href="/delivery-policy" class="hover:text-white transition-colors">Digital Delivery Policy</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact & Support</a></li>
        </ul>
      </div>

    </div>

    <!-- Security & Legitimacy Statement -->
    <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60 text-xs text-slate-400 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>
          <strong class="text-white">Strict Security Rule:</strong> We never request or store client passwords, OTPs, or recovery codes. We strictly do not engage in fake reviews, maps manipulation, or pirated software.
        </span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-950 text-emerald-400 border border-emerald-800">
          Razorpay Secured Payments
        </span>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {new Date().getFullYear()} {site.brandName}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span>Cloudflare Pages Hosted</span>
        <span>•</span>
        <span>UPI / Cards / NetBanking</span>
      </div>
    </div>

  </div>
</footer>
